<Window x:Class="Cajolote.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cajolote - Iniciar Sesión"
        Width="420" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="16" Background="#F8F0F5" Padding="30" MouseLeftButtonDown="Border_MouseLeftButtonDown" BorderBrush="#E8C4D8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#00000040" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close button in top-right -->
            <Button Content="✕" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Background="Transparent" 
                    Foreground="#6B5A68" 
                    FontSize="16" 
                    FontWeight="Bold"
                    BorderThickness="0" 
                    Cursor="Hand" 
                    Click="CloseButton_Click"
                    Margin="0,-10,-10,0"
                    Width="30" Height="30">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,10,0,20" HorizontalAlignment="Center">
                <Border Width="80" Height="80" Background="#F3D9E5" CornerRadius="40" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <Image Source="icon.png" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="FormTitleTextBlock" Text="Iniciar Sesión" FontSize="24" FontWeight="Bold" Foreground="#4A3B47" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FormSubTitleTextBlock" Text="Punto de Venta - Cajolote" FontSize="13" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ErrorMessageTextBlock" 
                               Foreground="#E74C3C" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="LoginFormContainer">
                        <StackPanel x:Name="NombreInputContainer" Visibility="Collapsed">
                            <TextBlock Text="Nombre completo" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                            <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                                <TextBox x:Name="NombreTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Correo electrónico" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="EmailTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>

                        <TextBlock Text="Contraseña" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,5" Background="White">
                            <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,15">
                            <Hyperlink Click="ForgotPassword_Click" Foreground="#A78BFA" TextDecorations="Underline" Cursor="Hand">
                                <Run Text="¿Olvidaste tu contraseña?"/>
                            </Hyperlink>
                        </TextBlock>

                        <!-- Submit Button -->
                        <Border CornerRadius="8" Height="45" Margin="0,10,0,15">
                            <Button x:Name="SubmitButton" 
                                    Content="Iniciar Sesión"
                                    Background="#7ACB8A" Foreground="White"
                                    FontSize="16" FontWeight="Bold" Padding="12,0"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="SubmitButton_Click"/>
                        </Border>

                        <Grid Margin="0,5,0,15" x:Name="DividerGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Separator Grid.Column="0" Background="#E8C4D8" Height="1" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="o" FontSize="13" Foreground="#6B5A68" Margin="10,0"/>
                            <Separator Grid.Column="2" Background="#E8C4D8" Height="1" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Google login button (optional/disabled for phase 1 REST API, hidden or styled) -->
                        <Border CornerRadius="8" Height="45" Margin="0,0,0,20" x:Name="GoogleLoginBorder" Visibility="Collapsed">
                            <Button Content="Continuar con Google"
                                    Background="White" Foreground="#4A3B47"
                                    FontSize="14" Padding="12,10"
                                    BorderBrush="#E8C4D8" BorderThickness="2" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🔵" FontSize="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="14"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>

                        <Separator Background="#E8C4D8" Height="1" Margin="0,0,0,15"/>

                        <TextBlock x:Name="ToggleModeTextBlock" HorizontalAlignment="Center" FontSize="13" Foreground="#6B5A68">
                            <Run x:Name="ToggleModePrefixRun" Text="¿No tienes cuenta? "/>
                            <Hyperlink Click="ToggleMode_Click" Foreground="#A78BFA" TextDecorations="Underline" Cursor="Hand">
                                <Run x:Name="ToggleModeLinkRun" Text="Crear cuenta" FontWeight="Bold"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Contenedor para recuperar contraseña -->
                    <StackPanel x:Name="RecoveryFormContainer" Visibility="Collapsed">
                        <TextBlock Text="Ingresa tu correo electrónico registrado y te enviaremos un enlace para restablecer tu contraseña." FontSize="13" Foreground="#6B5A68" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Correo electrónico" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="RecoveryEmailTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <Border CornerRadius="8" Height="45" Margin="0,10,0,15">
                            <Button x:Name="RecoverySubmitButton" 
                                    Content="Enviar Enlace"
                                    Background="#7ACB8A" Foreground="White"
                                    FontSize="16" FontWeight="Bold" Padding="12,0"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="RecoverySubmitButton_Click"/>
                        </Border>

                        <Separator Background="#E8C4D8" Height="1" Margin="0,0,0,15"/>

                        <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#6B5A68">
                            <Hyperlink Click="BackToLogin_Click" Foreground="#A78BFA" TextDecorations="Underline" Cursor="Hand">
                                <Run Text="Volver a iniciar sesión" FontWeight="Bold"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Contenedor del formulario de configuración inicial de la tienda -->
                    <StackPanel x:Name="StoreSetupFormContainer" Visibility="Collapsed">
                        <TextBlock Text="Nombre de la Tienda (Obligatorio)" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="SetupStoreNameTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <TextBlock Text="RFC (Opcional)" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="SetupRfcTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <TextBlock Text="Teléfono (Opcional)" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="SetupPhoneTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <TextBlock Text="Dirección (Opcional)" FontSize="13" Foreground="#6B5A68" Margin="0,0,0,5"/>
                        <Border BorderBrush="#E8C4D8" BorderThickness="2" CornerRadius="8" Margin="0,0,0,15" Background="White">
                            <TextBox x:Name="SetupAddressTextBox" FontSize="14" Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>

                        <!-- Submit Button -->
                        <Border CornerRadius="8" Height="45" Margin="0,10,0,15">
                            <Button x:Name="SetupSubmitButton" 
                                    Content="Guardar y Terminar"
                                    Background="#7ACB8A" Foreground="White"
                                    FontSize="16" FontWeight="Bold" Padding="12,0"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="SetupSubmitButton_Click"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- Overlay de Alerta Personalizado (Modo Modal Interno) -->
            <Grid x:Name="NotificationOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#80000000" Margin="-30">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Background="#F8F0F5" CornerRadius="12" Padding="20" BorderBrush="#E8C4D8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#00000030" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="OverlayIcon" Text="🏪" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OverlayTitle" Text="Mensaje" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <TextBlock x:Name="OverlayMessage" Text="Contenido..." FontSize="13" Foreground="#6B5A68" TextWrapping="Wrap" LineHeight="18"/>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" ClipToBounds="False">
                            <Button x:Name="BtnCancel" Content="Cancelar" Margin="0,0,12,0" Width="85" Height="28" 
                                    Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"
                                    Background="#FADBD8" Foreground="#C0392B" Cursor="Hand" Click="OverlayCancel_Click"/>
                            <Button x:Name="BtnOk" Content="Aceptar" Width="85" Height="28" 
                                    Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"
                                    Background="#7ACB8A" Foreground="White" Cursor="Hand" Click="OverlayOk_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
