<Window x:Class="Cajolote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#FBF6F6"
        Title="Cajolote"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- ===================== ESTILOS ===================== -->
    <Window.Resources>
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D3142"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0 8 0 8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid ClipToBounds="False">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    BorderThickness="0">
                                <ContentPresenter Margin="10 8" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <!-- Badge -->
                            <Border x:Name="BadgeBorder"
                                    Background="#EDE7E7"
                                    BorderBrush="#DCD4D4"
                                    BorderThickness="1.5"
                                    CornerRadius="5"
                                    Padding="5,1,5,1.5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-5,8,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EDE7E7" BlurRadius="3" ShadowDepth="1" Opacity="0.15"/>
                                </Border.Effect>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="#6B707E"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="">
                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFAEC0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFAEC0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBF6F6"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
            <Setter Property="Margin" Value="5 10 0 0"/>
        </Style>

        <Style x:Key="ActionButtonGreen" TargetType="Button">
            <Setter Property="Background" Value="#7ACB8A"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonPurple" TargetType="Button" BasedOn="{StaticResource ActionButtonGreen}">
            <Setter Property="Background" Value="#A78BFA"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#FFD0D8" Grid.Column="0" MouseLeftButtonDown="Sidebar_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera Sidebar con Logo, Nombre y Conexión -->
                <StackPanel Grid.Row="0" Margin="20,20,20,15" HorizontalAlignment="Center">
                    <Grid Width="100" Height="100" HorizontalAlignment="Center">
                        <!-- Default icon when no profile image exists -->
                        <Ellipse x:Name="DefaultLogoBorder" Width="100" Height="100">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="icon.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Profile image when it exists -->
                        <Ellipse x:Name="ProfileLogoBorder" Width="100" Height="100" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ProfileLogoBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Indicador de presencia / conexión (bottom-right) -->
                        <Border x:Name="ConnectionStatusDot" 
                                Width="18" Height="18" 
                                CornerRadius="9" 
                                Background="#76C893" 
                                BorderBrush="#FF94A2" 
                                BorderThickness="2" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,0,2,2"
                                ToolTip="Estado de Conexión a Internet">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <!-- Nombre de la Tienda -->
                    <TextBlock x:Name="TxtStoreName" 
                               Text="Mi Tienda" 
                               Foreground="#2D3142" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="200"/>

                    <!-- Estado descriptivo de red -->
                    <TextBlock x:Name="TxtConnectionStatus" 
                               Text="Cargando..." 
                               Foreground="#2D3142" 
                               FontSize="10" 
                               HorizontalAlignment="Center" 
                               Margin="0,2,0,0"
                               Opacity="0.85"/>
                </StackPanel>

                <!-- Botones del menú (scrollables) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
                    <StackPanel>
                        <RadioButton x:Name="BtnMenu" Content="🏠 Menú"
                                     Tag="Alt+1"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Main_Click"/>

                        <RadioButton x:Name="BtnNuevaVenta" Content="🛒 Nueva Venta"
                                     Tag="Alt+2"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="NuevaCompra_Click"/>

                        <RadioButton x:Name="BtnRevisarPrecio" Content="🏷️ Revisar precio"
                                     Tag="Alt+3"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="RevisarPrecio_Click"/>

                        <RadioButton x:Name="BtnProductos" Content="📦 Productos"
                                     Tag="Alt+4"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Products_Click"/>

                        <RadioButton x:Name="BtnVentasRecientes" Content="🛍️ Ventas recientes"
                                     Tag="Alt+5"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Recientes_Click"/>

                        <RadioButton x:Name="BtnVentasTotales" Content="📁 Ventas totales"
                                     Tag="Alt+6"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Registros_Click"/>

                        <RadioButton x:Name="BtnEstadisticas" Content="📊 Estadísticas"
                                     Tag="Alt+7"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Estadisticas_Click"/>

                        <RadioButton x:Name="BtnNotas" Content="📝 Notas y deudas"
                                     Tag="Alt+8"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Notas_Click"/>

                        <RadioButton x:Name="BtnConfiguracion" Content="⚙️ Configuración"
                                     Tag="Alt+9"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Configuracion_Click"/>

                        <RadioButton x:Name="BtnPerfil" Content="👤 Perfil"
                                     Tag="Alt+0"
                                     Style="{StaticResource MenuRadioButtonStyle}"
                                     GroupName="SidebarMenu"
                                     Click="Perfil_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- COLUMNA PRINCIPAL CON CABECERA Y CONTENIDO -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER / BARRA DE TÍTULO -->
            <Border Grid.Row="0" 
                    Height="45" 
                    Background="#FBF6F6" 
                    BorderBrush="#EDE2E4" 
                    BorderThickness="0,0,0,1"
                    ToolTip="Arrastre o doble clic para maximizar/restaurar">
                
                <!-- BOTONES DE CONTROL DE VENTANA (CERRAR, MAXIMIZAR Y MINIMIZAR) -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" 
                            Content="─" 
                            Width="50" 
                            Height="36" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="#4A4E59" 
                            FontSize="25" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            Click="BtnMinimize_Click"
                            ToolTip="Minimizar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#EDE7E7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnMaximizeRestore" 
                            Content="🗗" 
                            Width="50" 
                            Height="36" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="#4A4E59" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            Click="BtnMaximizeRestore_Click"
                            ToolTip="Restaurar tamaño">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#EDE7E7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnClose" 
                            Content="✕" 
                            Width="50" 
                            Height="36" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="#4A4E59" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            Click="BtnClose_Click"
                            ToolTip="Cerrar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E67E80"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- CONTENIDO DINÁMICO -->
            <ContentControl x:Name="MainContent"
                        Grid.Row="1"
                        Margin="10"
                        Padding="20px"
                            />
        </Grid>

        <!-- LOADER PARA TRANSICIÓN DE VISTAS (Solo en columna 1) -->
        <Grid x:Name="ViewLoadingOverlay" Grid.Column="1" Background="#80FBF6F6" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="140">
                <Border.Effect>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,15" Foreground="#FF94A2"/>
                    <TextBlock x:Name="ViewLoadingStatusText" Text="Cargando..." FontSize="15" FontWeight="Bold" Foreground="#4A3B47" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LOADER OVERLAY (spanning both columns) -->
        <Grid x:Name="BackupOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <StackPanel>
                    <Image x:Name="BackupOverlayIcon" Source="{StaticResource di_Image}" Width="64" Height="64" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,20" Foreground="#A78BFA"/>
                    <TextBlock Text="Axito está trabajando..." FontSize="16" FontWeight="Bold" Foreground="#4A3B47" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="BackupOverlayStatusText" Text="Optimizando y respaldando ventas..." FontSize="13" Foreground="#6B5A68" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- OVERLAY DE ALERTA PERSONALIZADO (Modo Modal Interno) -->
        <Grid x:Name="NotificationOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#80000000">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Background="#F8F0F5" CornerRadius="12" Padding="20" BorderBrush="#E8C4D8" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#00000030" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="OverlayIcon" Text="🏪" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayTitle" Text="Mensaje" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <TextBlock x:Name="OverlayMessage" Text="Contenido..." FontSize="13" Foreground="#6B5A68" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" ClipToBounds="False">
                        <Button x:Name="BtnCancel" Content="Cancelar" Margin="0,0,12,0" Width="85" Height="28" 
                                Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"
                                Background="#FADBD8" Foreground="#C0392B" Cursor="Hand" Click="OverlayCancel_Click"/>
                        <Button x:Name="BtnOk" Content="Aceptar" Width="85" Height="28" 
                                Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"
                                Background="#7ACB8A" Foreground="White" Cursor="Hand" Click="OverlayOk_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
