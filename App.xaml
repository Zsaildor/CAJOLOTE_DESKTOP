<Application x:Class="Cajolote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cajolote"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Assets/Icons/ProductIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Assets/Axito_Icons/preparing.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Assets/Axito_Icons/sync.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ModalButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FBF6F6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="contentPresenter"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <!-- Badge -->
                                    <Border x:Name="BadgeBorder"
                                            Background="#EDE7E7"
                                            BorderBrush="#DCD4D4"
                                            BorderThickness="1.5"
                                            CornerRadius="5"
                                            Padding="5,1,5,1.5"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{TemplateBinding Tag}"
                                                   Foreground="#6B707E"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="">
                                    <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="#00FFFFFF"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="{TemplateBinding Background}">
                                        <primitives:Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                            <primitives:Track.Thumb>
                                                <primitives:Thumb>
                                                    <primitives:Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                                            <Border x:Name="thumbBorder" Background="#E0E0E0" CornerRadius="4" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="thumbBorder" Property="Background" Value="#BDBDBD"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </primitives:Thumb.Template>
                                                </primitives:Thumb>
                                            </primitives:Track.Thumb>
                                        </primitives:Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="{TemplateBinding Background}">
                                        <primitives:Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="false" IsEnabled="{TemplateBinding IsEnabled}">
                                            <primitives:Track.Thumb>
                                                <primitives:Thumb>
                                                    <primitives:Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                                                            <Border x:Name="thumbBorder" Background="#E0E0E0" CornerRadius="4" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="thumbBorder" Property="Background" Value="#BDBDBD"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </primitives:Thumb.Template>
                                                </primitives:Thumb>
                                            </primitives:Track.Thumb>
                                        </primitives:Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom RadioButton Style -->
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#4A3B47"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="radioButtonBorder" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="outerCircle" 
                                             Stroke="#CED4DA" 
                                             StrokeThickness="2" 
                                             Fill="Transparent"/>
                                    <Ellipse x:Name="innerCircle" 
                                             Width="10" 
                                             Height="10" 
                                             Fill="Transparent" 
                                             HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter x:Name="contentPresenter" 
                                                  Grid.Column="1" 
                                                  Focusable="False" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  Margin="{TemplateBinding Padding}" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter TargetName="outerCircle" Property="Stroke" Value="#FFAEC0"/>
                                    <Setter TargetName="innerCircle" Property="Fill" Value="#FFAEC0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="outerCircle" Property="Stroke" Value="#9B5DE5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keyboard Shortcut Badge Styles -->
            <Style x:Key="KeyboardShortcutStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8F9FA"/>
                <Setter Property="BorderBrush" Value="#DEE2E6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="5,1.5,5,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style x:Key="KeyboardShortcutTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#495057"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
