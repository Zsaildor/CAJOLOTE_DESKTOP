<UserControl x:Class="Cajolote.Views.RecientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaleItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000010" BlurRadius="4" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ventas Recientes" FontSize="28" FontWeight="Bold" Foreground="#4A4E59"/>
                        <Border Margin="10,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+T para seleccionar los registros y ↑↓ para desplazarte sin mouse/ratón" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Últimas transacciones del día de hoy" FontSize="14" Foreground="#4A4E59"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="8" VerticalAlignment="Bottom" Margin="10, 0, 10, 0">
                    <Button Background="#76C893" Foreground="White"
                            FontSize="14" Padding="15,5" BorderThickness="0"
                            Cursor="Hand" Click="BtnNuevaVenta_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+ Nueva Venta" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Alt+2" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
            <ListBox x:Name="SalesListBox" ItemsSource="{Binding RecentSales}" Background="Transparent" BorderThickness="0" Focusable="True" SelectionMode="Single" Margin="0,0,0,10" PreviewMouseWheel="SalesListBox_PreviewMouseWheel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="8" Background="White" Margin="10,0,10,8" Padding="15" SnapsToDevicePixels="true">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00000010" BlurRadius="4" ShadowDepth="1"/>
                                        </Border.Effect>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF0F2"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                        </MultiDataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Expander Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#D5F5E3" CornerRadius="8"
                                                Width="50" Height="50">
                                            <TextBlock Text="🛒" FontSize="22" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id, StringFormat='Venta #{0:0000}'}" FontSize="16" FontWeight="Bold" Foreground="#4A4E59"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='hh:mm tt'}" FontSize="14" Foreground="#4A4E59"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding TotalProductsCount, StringFormat='{}{0} productos · '}" FontSize="13" Foreground="#4A4E59"/>

                                                <TextBlock Text="Pagada · " FontSize="13" Foreground="#2B9348" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock FontSize="13" Foreground="#E76F51" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.Text>
                                                        <Binding Path="Note.CustomerName" StringFormat="Fiada (Deuda: {0}) · " TargetNullValue="Fiada · " FallbackValue="Fiada · "/>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <TextBlock Text="Sincronizado" FontSize="13" Foreground="#3498DB" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="No sincronizado" FontSize="13" Foreground="#ADB5BD" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSynced}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding EditedAt, StringFormat=' · Registro editado {0:dd/MM/yyyy HH:mm}'}" FontSize="13" Foreground="#7B2CBF" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#7ACB8A" VerticalAlignment="Center"/>
                                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Enter" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                
                                <StackPanel Margin="65,10,10,10">
                                        <Separator Background="#4A4E59" Margin="0,0,0,10"/>
                                    <TextBlock Text="Detalles de la compra:" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,0,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding QuantityDisplay}" FontSize="13" FontWeight="Bold" Foreground="#4A4E59" Grid.Column="0"/>
                                                        <TextBlock Text="{Binding Product.Name}" FontSize="13" Foreground="#4A4E59" Grid.Column="1" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="13" FontWeight="Bold" Foreground="#4A4E59" Grid.Column="2" TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                        <!-- Botón Eliminar Venta -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Button Content="❌ Eliminar Venta" 
                                                    Command="{Binding DataContext.DeleteSaleFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#FFE3E3" Foreground="#E5383B" 
                                                    BorderThickness="0" Padding="10,5" 
                                                    Cursor="Hand" FontWeight="Bold"/>
                                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Ctrl+Supr" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Botón Editar Venta -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="✏️ Editar Venta" 
                                                    Command="{Binding DataContext.EditSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#E0EBFF" Foreground="#4361EE" 
                                                    BorderThickness="0" Padding="10,5" 
                                                    Cursor="Hand" FontWeight="Bold"/>
                                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Ctrl+E" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                         <!-- Botón Fiar Venta -->
                                         <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>
                                             <Button Content="📝 Marcar com Fiado" 
                                                     Command="{Binding DataContext.FiarVentaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                     CommandParameter="{Binding}" 
                                                     Background="#FFECD1" Foreground="#F77F00" 
                                                     BorderThickness="0" Padding="10,5" 
                                                     Cursor="Hand" FontWeight="Bold"/>
                                             <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                 <TextBlock Text="Ctrl+D" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                             </Border>
                                         </StackPanel>

                                         <!-- Botón Reimprimir Ticket -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="🖨️ Reimprimir Ticket" 
                                                    Command="{Binding DataContext.ReimprimirTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#D8F3DC" Foreground="#2D6A4F" 
                                                    BorderThickness="0" Padding="10,5" 
                                                    Cursor="Hand" FontWeight="Bold"/>
                                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Ctrl+P" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>
                                    
                                    <TextBlock Text="Deuda manual cobrada (Sin detalles de productos)" FontSize="13" FontStyle="Italic" Foreground="#999" Margin="0,0,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Mensaje si no hay ventas hoy -->
            <TextBlock Text="Aún no hay ventas registradas el día de hoy." 
                       FontSize="16" Foreground="#999" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentSales.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
    <materialDesign:Snackbar MessageQueue="{Binding ErrorMessageQueue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>

    <!-- Modal overlay para reimprimir ticket -->
    <Grid x:Name="PrintModalGrid" Background="#80000000" Visibility="{Binding IsPrintModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <StackPanel>
                <TextBlock Text="Reimprimir Ticket" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="¿Desea reimprimir el ticket?" FontSize="16" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="No" Command="{Binding SkipPrintTicketCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Sí" Command="{Binding ConfirmPrintTicketCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay para editar venta -->
    <Grid x:Name="EditModalGrid" Background="#80000000" Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxHeight="600">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding SelectedSaleForEdit.Id, StringFormat='Editar Venta #{0:0000}'}" FontSize="20" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <!-- Lista de productos en la venta -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding EditingDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FBF6F6" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=C}" FontSize="12" Foreground="#4A4E59"/>
                                        </StackPanel>
                                        
                                        <!-- Cantidad con - y + y TextBox -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Command="{Binding DataContext.DecreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand"/>
                                            <TextBox Text="{Binding QuantityString, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0" TextAlignment="Center" FontSize="14" VerticalAlignment="Center" Focusable="True" BorderThickness="1.5" Background="White" Padding="0,2">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderBrush" Value="#CED4DA"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FF94A2"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="+" Command="{Binding DataContext.IncreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#D5F5E3" Foreground="#27AE60" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat=C}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        
                                        <Button Grid.Column="3" Command="{Binding DataContext.RemoveEditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" Margin="10,0,0,0" ToolTip="Quitar producto" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Total actualizable -->
                <Grid Grid.Row="2" Margin="0,5,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Foreground="#4A3B47"/>
                    <TextBlock Grid.Column="1" Text="{Binding EditingTotal, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="#7ACB8A"/>
                </Grid>
                
                <!-- Botones de Guardar / Cancelar / Eliminar todo -->
                <Grid Grid.Row="3" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Eliminar Venta" Command="{Binding DeleteSaleCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}"/>
                    <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelEditCommand}" Background="#E5E7EB" Foreground="#374151" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="4" Content="Guardar" Command="{Binding SaveEditCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- Modal overlay para confirmar eliminación de venta -->
    <Grid x:Name="DeleteModalGrid" Background="#80000000" Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <StackPanel>
                <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SaleToDelete.Id, StringFormat='¿Está seguro de que desea eliminar por completo la venta #{0:0000}?'}" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteSaleCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmDeleteSaleCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay para fiar (deuda) -->
    <Grid x:Name="CreditModal" Background="#80000000" Visibility="{Binding IsCreditModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <StackPanel>
                <TextBlock Text="Fiar Venta a Cliente" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                <TextBlock Text="Selecciona la cuenta (nota) del cliente o crea una nueva:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,10" TextWrapping="Wrap"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                    <CheckBox x:Name="NewCreditAccountCheckBox" Content="Crear nueva cuenta / deudor" IsChecked="{Binding CreateNewCreditAccount}" FontSize="14" Foreground="#4A3B47"/>
                    <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Ctrl+N" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                    </Border>
                </StackPanel>
                
                <!-- Border para ComboBox -->
                <Border x:Name="CreditCustomerComboBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="CreditCustomerComboBoxBorder_IsVisibleChanged">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ComboBox x:Name="CreditCustomerComboBox" ItemsSource="{Binding AvailableNotes}" SelectedItem="{Binding SelectedNote}" materialDesign:HintAssist.Hint="Seleccionar Cliente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="16" Padding="10,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold"/>
                                    <TextBlock Text=" (Deuda: "/>
                                    <TextBlock Text="{Binding Amount, StringFormat=C}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <!-- Border para TextBox -->
                <Border x:Name="NewCreditCustomerTextBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="NewCreditCustomerTextBoxBorder_IsVisibleChanged">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="NewCreditCustomerTextBox" Text="{Binding NewCreditCustomerName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nombre del nuevo cliente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="16" Padding="10,8"/>
                </Border>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCreditCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Confirmar" Command="{Binding ConfirmCreditCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
