<UserControl x:Class="Cajolote.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cajolote.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:converters="clr-namespace:Cajolote.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             SizeChanged="UserControl_SizeChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewTextInput="UserControl_PreviewTextInput">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ResourceKeyToIconConverter x:Key="ResourceKeyToIcon"/>
        <converters:IconKeyToFriendlyNameConverter x:Key="IconKeyToFriendlyName"/>
        <converters:ProgressToBrushConverter x:Key="ProgressToBrushConverter"/>

        <GroupStyle x:Key="QuickProductsGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Height="3" Background="#F0E6EC" Margin="5,15,5,10"/>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#A78BFA" Margin="5,0,5,8"/>
                    </StackPanel>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="#9B5DE5" StrokeThickness="2.5" RadiusX="6" RadiusY="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBF6F6"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Width="35" Height="35" Margin="0,2"
                                       Source="{Binding IconKey, Converter={StaticResource ResourceKeyToIcon}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Grid.Row="1" Text="{TemplateBinding Content}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="{TemplateBinding Tag}" FontSize="11" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFAEC0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MainGrid" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColCart" Width="420"/>
                    <ColumnDefinition x:Name="ColProducts" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowCart" Height="*"/>
                    <RowDefinition x:Name="RowProducts" Height="0"/>
                </Grid.RowDefinitions>

        <!-- Left: Cart (previously on the right) -->
        <Border x:Name="CartBorder" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Carrito" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,4"/>
                        <Border HorizontalAlignment="Left" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5">
                            <TextBlock Text="Ctrl+K para seleccionar carrito y ↑↓ para desplazarte sin mouse/ratón" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClearCartCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#E67E80"
                            Padding="0" Cursor="Hand" Focusable="False"
                            ToolTip="Vaciar Carrito (Ctrl+Supr)" VerticalAlignment="Center"
                            FocusVisualStyle="{StaticResource ThemeFocusVisual}">
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                            <Border Margin="5,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+Supr" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Empty Cart State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CartItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Viewbox Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                        <lottie:LottieAnimationView 
                            ResourcePath="pack://application:,,,/Cajolote;component/Assets/Animations/waiting.json" 
                            AutoPlay="True" 
                            RepeatCount="-1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Height="1000" Width="1000"/>
                    </Viewbox>
                    <TextBlock Text="Escanea para iniciar una nueva venta..." 
                               FontSize="16" 
                               Foreground="#4A4E59"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,0"
                               FontWeight="Medium"/>
                </StackPanel>

                 <ScrollViewer x:Name="CartScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CartItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ListBox x:Name="CartListBox" ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0" Focusable="True" HorizontalContentAlignment="Stretch" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="CartListBox_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Padding="0" SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                 <Border x:Name="ItemBorder" CornerRadius="8" Padding="10" RenderTransformOrigin="0.5,0.5">
                                     <Border.Style>
                                         <Style TargetType="Border">
                                             <Setter Property="Background" Value="#FBF6F6"/>
                                             <Setter Property="BorderBrush" Value="Transparent"/>
                                             <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                             <Style.Triggers>
                                                 <MultiDataTrigger>
                                                     <MultiDataTrigger.Conditions>
                                                         <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                         <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                     </MultiDataTrigger.Conditions>
                                                     <Setter Property="Background" Value="#FFF0F2"/>
                                                     <Setter Property="BorderBrush" Value="#FFAEC0"/>
                                                 </MultiDataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </Border.Style>
                                     <Border.RenderTransform>
                                         <ScaleTransform ScaleX="1" ScaleY="1"/>
                                     </Border.RenderTransform>
                                     <Border.Triggers>
                                         <EventTrigger RoutedEvent="Border.Loaded">
                                             <BeginStoryboard>
                                                 <Storyboard>
                                                     <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                      From="0.8" To="1.0" Duration="0:0:0.15">
                                                         <DoubleAnimation.EasingFunction>
                                                             <QuadraticEase EasingMode="EaseOut"/>
                                                         </DoubleAnimation.EasingFunction>
                                                     </DoubleAnimation>
                                                     <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                      From="0.8" To="1.0" Duration="0:0:0.15">
                                                         <DoubleAnimation.EasingFunction>
                                                             <QuadraticEase EasingMode="EaseOut"/>
                                                         </DoubleAnimation.EasingFunction>
                                                     </DoubleAnimation>
                                                     <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                      From="0.0" To="1.0" Duration="0:0:0.15"/>
                                                 </Storyboard>
                                             </BeginStoryboard>
                                         </EventTrigger>
                                     </Border.Triggers>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="125"/>
                                             <ColumnDefinition Width="60"/>
                                             <ColumnDefinition Width="35"/>
                                             <ColumnDefinition Width="35"/>
                                         </Grid.ColumnDefinitions>
                                         <StackPanel>
                                             <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" TextWrapping="Wrap"/>
                                             <TextBlock Text="{Binding UnitPrice, StringFormat=C}" FontSize="12" Foreground="#4A4E59"/>
                                         </StackPanel>
                                         <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                             <Grid>
                                                 <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand" Focusable="False"/>
                                                 <Border x:Name="MinusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="-" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                             <Grid Margin="6,0">
                                                 <Button Command="{Binding DataContext.EditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Editar Cantidad" Focusable="False">
                                                     <TextBlock Text="{Binding QuantityDisplay}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                                                 </Button>
                                                 <Border x:Name="QtyBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="Q" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                             <Grid>
                                                 <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#D5F5E3" Foreground="#27AE60" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand" Focusable="False"/>
                                                 <Border x:Name="PlusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="+" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                         </StackPanel>
                                         <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat=C}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                         <Grid Grid.Column="3">
                                             <Button Command="{Binding DataContext.EditPriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Padding="0" ToolTip="Editar Precio" Cursor="Hand" Focusable="False">
                                                 <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                             </Button>
                                             <Border x:Name="PriceBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                 <TextBlock Text="P" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                             </Border>
                                         </Grid>
                                         <Grid Grid.Column="4">
                                             <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Quitar" Cursor="Hand" Focusable="False">
                                                 <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                             </Button>
                                             <Border x:Name="RemoveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                 <TextBlock Text="Supr" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                             </Border>
                                         </Grid>
                                     </Grid>
                                 </Border>
                                 <DataTemplate.Triggers>
                                     <MultiDataTrigger>
                                         <MultiDataTrigger.Conditions>
                                             <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                             <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                         </MultiDataTrigger.Conditions>
                                         <Setter TargetName="MinusBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="PlusBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="QtyBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="PriceBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="RemoveBadge" Property="Visibility" Value="Visible"/>
                                     </MultiDataTrigger>
                                 </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Checkout Panel: Totals & Buttons (Bottom of Cart) -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total" FontSize="24" FontWeight="Bold" Foreground="#4A3B47"/>
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#76C893"/>
                    </Grid>
                    <Separator Background="#FF94A2" Height="1" Margin="0,5,0,15"/>
                    
                    <!-- Botón de Cobrar (Gran Protagonista) -->
                    <Border CornerRadius="8" Margin="0,0,0,10">
                        <Button Command="{Binding CheckoutCommand}"
                                Background="#76C893" Foreground="White"
                                Height="45" Focusable="False"
                                FontSize="16" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                FocusVisualStyle="{StaticResource ThemeFocusVisual}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💰 Cobrar" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+C" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                    
                    <!-- Botón de Fiar (Deuda) -->
                    <Border CornerRadius="8" Margin="0,0,0,0">
                        <Button Command="{Binding CheckoutCreditCommand}"
                                Background="#3b82f6" Foreground="White"
                                Height="35" Focusable="False"
                                FontSize="14" FontWeight="Bold" Padding="10,8"
                                BorderThickness="0" Cursor="Hand"
                                FocusVisualStyle="{StaticResource ThemeFocusVisual}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝 Fiar (Deuda)" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+D" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Product Selection (previously on the left + bottom-right) -->
        <Border x:Name="ProductsGrid" Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Seleccionar Productos" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,5,0,15">
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Campo de búsqueda -->
                            <TextBox Grid.Column="0" 
                                     x:Name="SearchTextBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Buscar producto rápido..." 
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     FontSize="16" Padding="10,12,10,8" BorderThickness="0"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>

                            <!-- Botón y badge Ctrl+X para limpiar (solo visible si hay texto) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Command="{Binding ClearSearchCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="#E67E80"
                                        Padding="2" Cursor="Hand" Width="24" Height="24"
                                        ToolTip="Limpiar Búsqueda (Ctrl+X)" Focusable="False">
                                    <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" VerticalAlignment="Center"/>
                                </Button>
                                <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock Text="Ctrl+X" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                                </Border>
                            </StackPanel>

                            <!-- Botón de bloqueo del temporizador -->
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleSearchTimerLockCommand}"
                                    BorderThickness="0"
                                    Padding="5" Margin="0,0,4,0" Width="30" Height="30"
                                    Cursor="Hand" ToolTip="Bloquear/Desbloquear Limpieza Automática (Ctrl+L)"
                                    VerticalAlignment="Center"
                                    FocusVisualStyle="{StaticResource ThemeFocusVisual}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="15"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearchTimerLocked}" Value="True">
                                                <Setter Property="Background" Value="#F0E6FF"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EDE7E7"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="{Binding LockIconKind}" Width="20" Height="20">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#ADB5BD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSearchTimerLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Foreground" Value="#9B5DE5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>

                            <!-- Badge para Candado -->
                            <Border Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl+L" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                            </Border>

                            <!-- Indicador visual del temporizador -->
                            <ProgressBar Grid.Column="0" Grid.ColumnSpan="5" 
                                         Height="3" VerticalAlignment="Bottom" Background="Transparent" 
                                         BorderThickness="0"
                                         Minimum="0" Maximum="100" 
                                         Value="{Binding SearchClearProgress}"
                                         Foreground="{Binding SearchClearProgress, Converter={StaticResource ProgressToBrushConverter}}"
                                         Visibility="{Binding ShowSearchClearProgress, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Floating Ctrl+F Badge on Top-Left Corner -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" IsHitTestVisible="False">
                        <TextBlock Text="Ctrl+F" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Sección 1: Productos Rápidos -->
                        <StackPanel Visibility="{Binding HasQuickProducts, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Productos Rápidos o Sin Código" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+Q" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                                </Border>
                            </StackPanel>
                            <ListBox x:Name="QuickProductsListBox" ItemsSource="{Binding QuickProducts}" Margin="0,0,0,15" Background="Transparent" BorderThickness="0" Focusable="True" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewKeyDown="QuickProductsListBox_PreviewKeyDown" PreviewMouseWheel="ListBox_PreviewMouseWheel" FocusVisualStyle="{x:Null}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" Background="Transparent" SnapsToDevicePixels="true">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="ProductButton" Content="{Binding Name}" Tag="{Binding Price, StringFormat=C}" 
                                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Width="120" Height="90" Style="{StaticResource ProductBtnStyle}" Focusable="False"/>
                                            <Border x:Name="TabBadge" Background="#76C893" CornerRadius="4" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" IsHitTestVisible="False" Visibility="Collapsed">
                                                <TextBlock Text="Tab ↹" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                    <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ProductButton" Property="Background" Value="#FFF0F2"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Sección 2: Otros Productos (Coincidencias en la base de datos) -->
                        <StackPanel Visibility="{Binding HasOtherResults, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Otros Resultados" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" Margin="0,5,0,8"/>
                            <ListBox x:Name="OtherProductsListBox" ItemsSource="{Binding OtherProducts}" Background="Transparent" BorderThickness="0" Focusable="True" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewKeyDown="QuickProductsListBox_PreviewKeyDown" PreviewMouseWheel="ListBox_PreviewMouseWheel" FocusVisualStyle="{x:Null}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" Background="Transparent" SnapsToDevicePixels="true">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF94A2"/>
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="ProductButton" Content="{Binding Name}" Tag="{Binding Price, StringFormat=C}" 
                                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Width="120" Height="90" Style="{StaticResource ProductBtnStyle}" Focusable="False"/>
                                            <Border x:Name="TabBadge" Background="#76C893" CornerRadius="4" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" IsHitTestVisible="False" Visibility="Collapsed">
                                                <TextBlock Text="Tab ↹" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                    <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ProductButton" Property="Background" Value="#FFF0F2"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
            </Grid>
        </ScrollViewer>

        <!-- Modal overlay para editar precio -->
        <Grid x:Name="EditPriceModal" Background="#80000000" Visibility="{Binding IsEditingPrice, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <StackPanel>
                    <TextBlock Text="Editar Precio" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding EditingCartItem.Product.Name}" FontSize="14" Foreground="#4A4E59" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    
                    <TextBox x:Name="NewPriceTextBox" materialDesign:HintAssist.Hint="Nuevo Precio" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Margin="0,0,0,20" IsVisibleChanged="QuantityTextBox_IsVisibleChanged"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelEditPriceCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveEditPriceCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para editar cantidad -->
        <Grid x:Name="EditQuantityModal" Background="#80000000" Visibility="{Binding IsEditingQuantity, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <StackPanel>
                    <TextBlock Text="Editar Cantidad" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding EditingCartItem.Product.Name}" FontSize="14" Foreground="#4A4E59" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    
                    <!-- Mostrar precio de referencia -->
                    <TextBlock FontSize="12" Foreground="#887784" Margin="0,0,0,15" Text="{Binding PriceReferenceText}"/>

                    <!-- Opciones de tipo de venta (por kg / por precio) - Solo para productos a granel -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15" Visibility="{Binding EditingCartItem.Product.IsBulk, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                            <RadioButton x:Name="ByWeightRadio" Content="{Binding WeightUnitOptionText}" IsChecked="{Binding IsQuantityByWeight}" FontSize="14" Foreground="#4A4E59" Checked="ByWeightRadio_Checked" VerticalAlignment="Center"/>
                            <Border Margin="5,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+G" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="ByPriceRadio" Content="Por precio" IsChecked="{Binding IsQuantityByPrice}" FontSize="14" Foreground="#4A4E59" Checked="ByPriceRadio_Checked" VerticalAlignment="Center"/>
                            <Border Margin="5,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+P" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Campos de entrada -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TextBox 1 (Cantidad / Peso) -->
                        <TextBox Grid.Column="0" 
                                 x:Name="QuantityTextBox" 
                                 FontSize="16"
                                 materialDesign:HintAssist.Hint="{Binding QuantityHint}"
                                 IsReadOnly="{Binding IsQuantityByPrice}"
                                 IsVisibleChanged="QuantityTextBox_IsVisibleChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                                    <Style.Triggers>
                                        <!-- Si no es bulk, toma todo el ancho -->
                                        <DataTrigger Binding="{Binding EditingCartItem.Product.IsBulk}" Value="False">
                                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                                        </DataTrigger>
                                        <!-- Estilo para cuando es inactivo/lectura -->
                                        <Trigger Property="IsReadOnly" Value="True">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Text>
                                <Binding Path="NewQuantity" UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveEditQuantityCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CancelEditQuantityCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- TextBox 2 (Monto / Precio) -->
                        <TextBox Grid.Column="2" 
                                 x:Name="PriceTextBox" 
                                 FontSize="16"
                                 IsReadOnly="{Binding IsQuantityByWeight}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Si es bulk, se muestra -->
                                        <DataTrigger Binding="{Binding EditingCartItem.Product.IsBulk}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="materialDesign:HintAssist.Hint" Value="Monto ($)"/>
                                        </DataTrigger>
                                        <!-- Estilo para cuando es inactivo/lectura -->
                                        <Trigger Property="IsReadOnly" Value="True">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Text>
                                <Binding Path="NewPriceAmount" UpdateSourceTrigger="PropertyChanged"/>
                            </TextBox.Text>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveEditQuantityCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CancelEditQuantityCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelEditQuantityCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveEditQuantityCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para fiar -->
        <Grid x:Name="CreditModal" Background="#80000000" Visibility="{Binding IsCreditModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <StackPanel>
                    <TextBlock Text="Fiar Venta a Cliente" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                    <TextBlock Text="Selecciona la cuenta (nota) del cliente o crea una nueva:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                        <CheckBox x:Name="NewCreditAccountCheckBox" Content="Crear nueva cuenta / deudor" IsChecked="{Binding CreateNewCreditAccount}" FontSize="14" Foreground="#4A3B47"/>
                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="Ctrl+N" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Border para ComboBox -->
                    <Border x:Name="CreditCustomerComboBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="CreditCustomerComboBoxBorder_IsVisibleChanged">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ComboBox x:Name="CreditCustomerComboBox" ItemsSource="{Binding AvailableNotes}" SelectedItem="{Binding SelectedNote}" materialDesign:HintAssist.Hint="Seleccionar Cliente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="16" Padding="10,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CustomerName}" FontWeight="Bold"/>
                                        <TextBlock Text=" (Deuda: "/>
                                        <TextBlock Text="{Binding Amount, StringFormat=C}"/>
                                        <TextBlock Text=")"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <!-- Border para TextBox -->
                    <Border x:Name="NewCreditCustomerTextBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="NewCreditCustomerTextBoxBorder_IsVisibleChanged">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox x:Name="NewCreditCustomerTextBox" Text="{Binding NewCreditCustomerName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nombre del nuevo cliente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="16" Padding="10,8"/>
                    </Border>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCreditCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Confirmar" Command="{Binding ConfirmCreditCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para imprimir ticket -->
        <Grid Background="#80000000" Visibility="{Binding IsPrintModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <StackPanel>
                    <TextBlock Text="Venta Completada" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="¿Desea imprimir el ticket?" FontSize="16" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="No" Command="{Binding SkipPrintTicketCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Sí" Command="{Binding ConfirmPrintTicketCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para registrar producto no encontrado -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsAddingProduct, Converter={StaticResource BoolToVis}}" PreviewKeyDown="ProductModal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="ProductModalBorder" Style="{StaticResource CardStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Registrar Producto No Encontrado" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                            <RadioButton GroupName="ProductTypePos" Content="Por Unidad" IsChecked="{Binding IsProductUnit}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+U" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ProductTypePos" Content="A Granel" IsChecked="{Binding IsProductBulk}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+G" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White">
                            <TextBox x:Name="BarcodeTextBox" materialDesign:HintAssist.Hint="Código de Barras" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                            <CheckBox Content="Sin código" IsChecked="{Binding ProductHasNoBarcode}" IsEnabled="False" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="NameTextBox" materialDesign:HintAssist.Hint="Nombre del Producto" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsVisibleChanged="NameTextBox_IsVisibleChanged"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <ComboBox x:Name="CategoryComboBox" materialDesign:HintAssist.Hint="Categoría" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.CategoryId}" FontSize="14"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="ProductPriceTextBox" materialDesign:HintAssist.Hint="{Binding PriceHint}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
                    </Border>

                    <!-- Selector Visual de Icono -->
                    <TextBlock Text="Icono del Producto (Opcional)" FontSize="12" Foreground="#887784" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previsualización del Icono Seleccionado -->
                        <Border Background="#FBF6F6" BorderBrush="#E8C4D8" BorderThickness="1.5" CornerRadius="8" Padding="10">
                            <Grid>
                                <!-- Estado: Sin Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="22" Height="22" Foreground="#887784" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sin ícono asignado" VerticalAlignment="Center" Foreground="#887784" FontSize="14"/>
                                </StackPanel>
                                
                                <!-- Estado: Con Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="{Binding SelectedProduct.IconKey, Converter={StaticResource ResourceKeyToIcon}}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedProduct.IconKey, Converter={StaticResource IconKeyToFriendlyName}}" VerticalAlignment="Center" Foreground="#4A4E59" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Botones de Acción -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <!-- Botón Editar/Buscar -->
                            <Button Command="{Binding OpenIconSelectorCommand}" Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="0" Width="36" Height="36" ToolTip="Seleccionar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                            </Button>
                            
                            <!-- Botón Eliminar (Solo visible si hay un ícono seleccionado) -->
                            <Button Command="{Binding RemoveIconCommand}" Background="#E67E80" Foreground="white" BorderThickness="0" Padding="0" Width="36" Height="36" Margin="8,0,0,0" ToolTip="Quitar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <CheckBox Content="Mostrar en accesos rápidos" IsChecked="{Binding SelectedProduct.IsQuickProduct}" IsEnabled="{Binding ProductHasBarcode}" Focusable="False" FontSize="14" Foreground="#4A3B47"/>
                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+R" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelNewProductCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Height="35" Focusable="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModalButtonStyle}">
                                    <Setter Property="IsCancel" Value="True"/>
                                    <Setter Property="Tag" Value="Esc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconSelectorOpen}" Value="True">
                                            <Setter Property="IsCancel" Value="False"/>
                                            <Setter Property="Tag" Value=""/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveNewProductCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S" Height="35" Focusable="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para seleccionar icono -->
        <Grid x:Name="IconSelectorModal" Background="#80000000" Visibility="{Binding IsIconSelectorOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="IconSelectorModalBorder" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxHeight="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Seleccionar Icono del Producto" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Text="Elige un icono de la galería para identificar este producto rápido." FontSize="13" Foreground="#887784" VerticalAlignment="Bottom" Margin="0,25,0,15"/>
                    
                    <!-- Galería de iconos -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,15">
                        <ItemsControl ItemsSource="{Binding AvailableIcons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Width="110" Height="90" Margin="6"
                                            Style="{StaticResource IconCardButtonStyle}">
                                        <Button.Content>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding Converter={StaticResource ResourceKeyToIcon}}" Width="36" Height="36" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Converter={StaticResource IconKeyToFriendlyName}}" 
                                                           FontSize="11" 
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                           TextAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Botón Cancelar -->
                    <Button Grid.Row="2" Content="Cancelar" Command="{Binding CloseIconSelectorCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True" HorizontalAlignment="Right" Width="100" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar de Errores -->
        <materialDesign:Snackbar MessageQueue="{Binding ErrorMessageQueue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
