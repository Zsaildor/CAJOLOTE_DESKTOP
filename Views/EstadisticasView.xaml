<UserControl x:Class="Cajolote.Views.EstadisticasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6C757D"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3E8FF"/>
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9D5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Estadísticas" FontSize="28" FontWeight="Bold"
                       Foreground="#4A3B47" Margin="0,0,0,5"/>
            <TextBlock Text="Resumen de rendimiento y métricas" FontSize="14"
                        Foreground="#6B5A68" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Ver:" FontSize="14" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="MonthStatsRadio" Content="Este mes" IsChecked="True" VerticalAlignment="Center" Foreground="#4A3B47"/>
                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="5,0,20,0">
                    <TextBlock Text="Alt+M / Alt+7" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                </Border>
                
                <RadioButton x:Name="TotalStatsRadio" Content="Todo" IsChecked="False" VerticalAlignment="Center" Checked="TotalStatsRadio_Checked" Foreground="#4A3B47"/>
                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="5,0,0,0">
                    <TextBlock Text="Alt+T" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                </Border>
            </StackPanel>

            <Grid x:Name="StatsGrid" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColStat0" Width="*"/>
                    <ColumnDefinition x:Name="ColStat1" Width="*"/>
                    <ColumnDefinition x:Name="ColStat2" Width="*"/>
                    <ColumnDefinition x:Name="ColStat3" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowStat0" Height="*"/>
                    <RowDefinition x:Name="RowStat1" Height="0"/>
                    <RowDefinition x:Name="RowStat2" Height="0"/>
                    <RowDefinition x:Name="RowStat3" Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="StatCard0" Grid.Column="0" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ventas Hoy" Style="{StaticResource StatTitleStyle}"/>
                        <TextBlock Text="{Binding VentasHoy, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatCard1" Grid.Column="1" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ventas Semana" Style="{StaticResource StatTitleStyle}"/>
                        <TextBlock Text="{Binding VentasSemana, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatCard2" Grid.Column="2" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ventas Mes" Style="{StaticResource StatTitleStyle}"/>
                        <TextBlock Text="{Binding VentasMes, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StatCard3" Grid.Column="3" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Venta Promedio Mes" Style="{StaticResource StatTitleStyle}"/>
                        <TextBlock Text="{Binding TicketPromedio, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ChartsGrid1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColChart1_Left" Width="540"/>
                    <ColumnDefinition x:Name="ColChart1_Right" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowChart1_Top" Height="*"/>
                    <RowDefinition x:Name="RowChart1_Bottom" Height="0"/>
                </Grid.RowDefinitions>

                <Border x:Name="Chart1LeftCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10" Height="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ventas por Día" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="←" 
                                        Command="{Binding PreviousWeekCommand}" 
                                        IsEnabled="{Binding CanGoToPreviousWeek}"/>
                                <TextBlock Text="{Binding SelectedWeekLabel}" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="#495057" 
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <Button Style="{StaticResource NavButtonStyle}"
                                        Content="→" 
                                        Command="{Binding NextWeekCommand}" 
                                        IsEnabled="{Binding CanGoToNextWeek}"/>
                            </StackPanel>
                            <Border Grid.Column="2" 
                                    Background="#F8F9FA" 
                                    BorderBrush="#DEE2E6" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="8,4" 
                                    Margin="20,0,0,0" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="Teclado: ← / →" 
                                           FontSize="11" 
                                           FontWeight="Medium" 
                                           Foreground="#6C757D"/>
                            </Border>
                        </Grid>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding VentasPorDiaSeries}"
                            XAxes="{Binding VentasPorDiaXAxes}"
                            YAxes="{Binding VentasPorDiaYAxes}"
                            Margin="0,0,0,10">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border x:Name="Chart1RightCard" Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10,0,10,0" Height="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Productos Más Vendidos (Mes)" FontSize="15" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15"/>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding TopProductsSeries}"
                            XAxes="{Binding TopProductsXAxes}"
                            YAxes="{Binding TopProductsYAxes}"
                            Margin="0,0,0,5">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="ChartsGrid2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColChart2_Left" Width="*"/>
                    <ColumnDefinition x:Name="ColChart2_Right" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RowChart2_Top" Height="Auto"/>
                    <RowDefinition x:Name="RowChart2_Bottom" Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="Chart2LeftCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="10" Height="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Horas Pico (Mes)" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding PeakHoursSeries}"
                            XAxes="{Binding PeakHoursXAxes}"
                            YAxes="{Binding PeakHoursYAxes}"
                            Margin="0,0,0,10">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border x:Name="Chart2RightCard" Grid.Column="0" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="10,0,10,10" Height="350">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header with Title and Keyboard Shortcut Badge -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Ingresos por Categoría (Mes)" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="10,0,0,0">
                                <TextBlock Text="Ctrl+G para seleccionar/deseleccionar lista y ↑↓ para navegar" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                            </Border>
                        </StackPanel>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5.8*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4.2*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Column 0: Donut Chart -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Gráfica" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                
                                <Grid Grid.Row="1">
                                    <lvc:PieChart
                                        Series="{Binding CategorySeries}"
                                        LegendPosition="Hidden"
                                        Margin="0,0,0,0">
                                    </lvc:PieChart>
                                    
                                    <!-- Center Overlay -->
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140" ClipToBounds="False">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryChartCenterTitle}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#6B5A68" 
                                                       TextAlignment="Center" 
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CategoryChartCenterValue}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Foreground="#4A3B47" 
                                                       TextAlignment="Center" 
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            
                            <!-- Column 1: Vertical Divider -->
                            <Border Grid.Column="1" Width="1" Background="#E8C4D8" Margin="15,5,15,10" VerticalAlignment="Stretch"/>
                            
                            <!-- Column 2: Selectable List -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Lista" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="5,0,0,8"/>
                                
                                <ListBox x:Name="CategoriesListBox" Grid.Row="1" ItemsSource="{Binding CategoryLegendItems}" SelectedItem="{Binding SelectedLegendItem}" Background="Transparent" BorderThickness="0" Focusable="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Border" CornerRadius="6" Padding="6,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="4,0,0,0">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFAEC0"/>
                                                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>-->
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="13" Foreground="#4A3B47" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RevenueDisplay}" FontSize="13" Foreground="#6B5A68" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
