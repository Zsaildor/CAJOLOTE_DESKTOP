<UserControl x:Class="Cajolote.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             SizeChanged="UserControl_SizeChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Height" Value="305"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6C757D"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Encabezado de la página -->
                <TextBlock Text="Resumen del Día"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#4A3B47"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Monitoreo y estadísticas de la actividad de hoy"
                           FontSize="14"
                           Foreground="#6B5A68"
                           Margin="0,0,0,20"/>

                <!-- Grid de Tarjetas de Estadísticas (Fila superior) -->
                <Grid x:Name="StatsGrid" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColStat0" Width="*"/>
                        <ColumnDefinition x:Name="ColStat1" Width="*"/>
                        <ColumnDefinition x:Name="ColStat2" Width="*"/>
                        <ColumnDefinition x:Name="ColStat3" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RowStat0" Height="*"/>
                        <RowDefinition x:Name="RowStat1" Height="0"/>
                        <RowDefinition x:Name="RowStat2" Height="0"/>
                        <RowDefinition x:Name="RowStat3" Height="0"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="StatCard0" Grid.Column="0" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ventas Registradas" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding TodaySalesCount}" Style="{StaticResource StatValueStyle}" Foreground="#212529"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatCard1" Grid.Column="1" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Monto Total (Hoy)" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding TodayTotalAmount, StringFormat=C}" Style="{StaticResource StatValueStyle}" Foreground="#212529"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatCard2" Grid.Column="2" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Productos Vendidos" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding TodayProductsSold}" Style="{StaticResource StatValueStyle}" Foreground="#212529"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatCard3" Grid.Column="3" Grid.Row="0" Margin="10" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ticket Promedio (Hoy)" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding AverageTicketToday, StringFormat=C}" Style="{StaticResource StatValueStyle}" Foreground="#212529"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Grid de Contenido de Gráficos y Detalles -->
                <Grid x:Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColContent0" Width="1.5*"/>
                        <ColumnDefinition x:Name="ColContent1" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RowContent0" Height="Auto"/>
                        <RowDefinition x:Name="RowContent1" Height="Auto"/>
                        <RowDefinition x:Name="RowContent2" Height="Auto"/>
                        <RowDefinition x:Name="RowContent3" Height="0"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Gráfico de Ventas por Hora -->
                    <Border x:Name="ChartHourCard" Grid.Column="0" Grid.Row="0" Grid.RowSpan="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="10" Height="305">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ventas por Hora (Hoy)" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15"/>
                            <lvc:CartesianChart
                                Grid.Row="1"
                                Series="{Binding SalesPerHourSeries}"
                                XAxes="{Binding SalesPerHourXAxes}"
                                YAxes="{Binding SalesPerHourYAxes}"
                                Margin="0,0,0,10">
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <!-- Gráfico de Ventas Fiadas -->
                    <Border x:Name="ChartUnpaidCard" Grid.Column="0" Grid.Row="1" Grid.RowSpan="1" Grid.ColumnSpan="1" Style="{StaticResource CardStyle}" Margin="10" Height="305">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Ventas Fiadas (Hoy)" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,10"/>
                            
                            <lvc:CartesianChart
                                Grid.Row="1"
                                Series="{Binding UnpaidSalesSeries}"
                                XAxes="{Binding UnpaidSalesXAxes}"
                                YAxes="{Binding UnpaidSalesYAxes}"
                                Margin="0,0,0,10">
                                <lvc:CartesianChart.Style>
                                    <Style TargetType="lvc:CartesianChart">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnpaidSalesToday}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </lvc:CartesianChart.Style>
                            </lvc:CartesianChart>

                            <TextBlock Grid.Row="1" 
                                       Text="No hay ventas fiadas registradas hoy"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#6B5A68"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnpaidSalesToday}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Tarjeta de Productos Más Vendidos Hoy -->
                    <Border x:Name="TopProductsCard" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Grid.ColumnSpan="1" Style="{StaticResource CardStyle}" Margin="10" Height="305">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Productos Más Vendidos (Hoy)" FontSize="15" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,5"/>
                            <lvc:CartesianChart
                                Grid.Row="1"
                                Series="{Binding TopProductsSeries}"
                                XAxes="{Binding TopProductsXAxes}"
                                YAxes="{Binding TopProductsYAxes}"
                                Margin="0,0,0,5">
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <!-- Gráfico de Ventas por Categoría Hoy (Dona) -->
                    <Border x:Name="ChartCategoryCard" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="10" Height="350">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header with Title and Keyboard Shortcut Badge -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Ingresos por Categoría (Hoy)" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="10,0,0,0">
                                    <TextBlock Text="Ctrl+G para seleccionar/deseleccionar lista y ↑↓ para navegar" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                </Border>
                            </StackPanel>
                            
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4.2*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Column 0: Donut Chart -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Gráfica" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    
                                    <Grid Grid.Row="1">
                                        <lvc:PieChart
                                            Series="{Binding TodayCategorySeries}"
                                            LegendPosition="Hidden"
                                            Margin="0,0,0,0">
                                        </lvc:PieChart>
                                        
                                        <!-- Center Overlay -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140" ClipToBounds="False">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryChartCenterTitle}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#6B5A68" 
                                                           TextAlignment="Center" 
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CategoryChartCenterValue}" 
                                                           FontSize="16" 
                                                           FontWeight="Bold" 
                                                           Foreground="#4A3B47" 
                                                           TextAlignment="Center" 
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                
                                <!-- Column 1: Vertical Divider -->
                                <Border Grid.Column="1" Width="1" Background="#E8C4D8" Margin="15,5,15,10" VerticalAlignment="Stretch"/>
                                
                                <!-- Column 2: Selectable List -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Lista" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="5,0,0,8"/>
                                    
                                    <ListBox x:Name="CategoriesListBox" Grid.Row="1" ItemsSource="{Binding CategoryLegendItems}" SelectedItem="{Binding SelectedLegendItem}" Background="Transparent" BorderThickness="0" Focusable="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ListBox_PreviewMouseWheel">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border" CornerRadius="6" Padding="6,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="4,0,0,0">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFAEC0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="13" Foreground="#4A3B47" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RevenueDisplay}" FontSize="13" Foreground="#6B5A68" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
