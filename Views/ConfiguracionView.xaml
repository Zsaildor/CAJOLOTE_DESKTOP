<UserControl x:Class="Cajolote.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="ToggleRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Configuración" FontSize="28" FontWeight="Bold" Foreground="#4A3B47"/>
                <TextBlock Text="Ajustes del sistema y preferencias" FontSize="14" Foreground="#6B5A68"/>
            </StackPanel>

            <!-- Sincronización -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="☁️  Sincronización en la Nube" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Firebase Sync" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Sincronizar ventas y catálogo con Firestore" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E67E80" CornerRadius="12" Width="44" Height="24" Cursor="Hand"/>
                    </Grid>

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Autenticación Firebase" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Inicio de sesión con Firebase Authentication" FontSize="12" Foreground="#6B5A68" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Última reautenticación: " FontSize="11" Foreground="#9A8A97"/>
                                <TextBlock Text="{Binding LastSessionRefreshText}" FontSize="11" Foreground="#9A8A97" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding SessionStatusColor}" CornerRadius="12" Width="44" Height="24" Cursor="Hand"/>
                    </Grid>

                    <Separator Background="#F0E6EC" Height="1" Margin="0,5,0,15"/>

                    <!-- Verificación de Correo -->
                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Verificación de Correo" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="Estado: " FontSize="12" Foreground="#6B5A68"/>
                                <TextBlock Text="{Binding VerificationStatusText}" FontSize="12" Foreground="{Binding ResendStatusColor}" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ResendStatusMessage}" FontSize="11" Foreground="#9A8A97" FontStyle="Italic"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Button to trigger check status -->
                            <Button Content="Revisar Estado" 
                                    Command="{Binding RefreshVerificationStatusCommand}" 
                                    Visibility="{Binding CanResendVerification, Converter={StaticResource BoolToVis}}"
                                    Background="#E0EBFF" Foreground="#4361EE" BorderThickness="0"
                                    FontSize="12" Padding="10,4" Margin="0,0,10,0" Cursor="Hand" Height="30" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Button to trigger resend, visible only if not verified -->
                            <Button Content="Reenviar Correo" 
                                    Command="{Binding ResendVerificationEmailCommand}" 
                                    Visibility="{Binding CanResendVerification, Converter={StaticResource BoolToVis}}"
                                    Background="#4361EE" Foreground="#E0EBFF" BorderThickness="0"
                                    FontSize="12" Padding="10,4" Cursor="Hand" Height="30" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--<Separator Background="#F0E6EC" Height="1" Margin="0,5,0,15"/>

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Estado de conexión" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Verificar conexión con servidores Firebase" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#D5F5E3" CornerRadius="8" Padding="10,4">
                            <TextBlock Text="Conectado" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                        </Border>
                    </Grid>

                    <Border Background="#F8F0F5" CornerRadius="8" Padding="15" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Última sincronización" FontSize="13" Foreground="#6B5A68"/>
                                <TextBlock Text="" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="8">
                                <Button Content="Sincronizar ahora"
                                        Background="#A78BFA" Foreground="White" FontSize="13"
                                        Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                            </Border>
                        </Grid>
                    </Border>-->
                </StackPanel>
            </Border>

            <!-- Suscripción y Web -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🌐  Cuenta y Suscripción" Style="{StaticResource SectionTitleStyle}"/>

                    <Border Background="#F8F0F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Plan actual" FontSize="13" Foreground="#6B5A68"/>
                                <TextBlock Text="Gratuito · Sin sincronización" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" Margin="0,4,0,0"/>
                                <TextBlock Text="Tu plan solo incluye el software gratuito con datos locales. No tienes acceso a sincronización" FontSize="12" Foreground="#E74C3C" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!--<Border Grid.Column="1" CornerRadius="8" VerticalAlignment="Center">
                                <Button Content="Ver Planes"
                                        Background="#A78BFA" Foreground="White" FontSize="14"
                                        Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                            </Border>-->
                        </Grid>
                    </Border>

                    <!--<Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="App Web" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Acceder a la versión web de Cajolote" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="8" Cursor="">
                            <Button Content="Ir a Web"
                                    Background="#E8C4D8" Foreground="#4A3B47" FontSize="13"
                                    Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </Grid>-->
                </StackPanel>
            </Border>

            <!-- Preferencias -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="⚙️  Preferencias" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Medición a Granel" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                                <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+G" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Unidad de medida predeterminada" FontSize="12" Foreground="#6B5A68"/>
                            <TextBlock Text="Esta medida se usará cada que se venda productos a granel" FontSize="11" Foreground="#5B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InputControlBorderStyle}" Width="150">
                            <ComboBox x:Name="BulkUnitComboBox" FontSize="14" Padding="6,4" BorderThickness="0" SelectedIndex="{Binding SelectedBulkUnitIndex, Mode=TwoWay}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                                <ComboBoxItem Content="Kilogramos (kg)"/>
                                <ComboBoxItem Content="Gramos (gr)"/>
                            </ComboBox>
                        </Border>
                    </Grid>

                    <Separator Background="#F0E6EC" Height="1" Margin="0,5,0,15"/>

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Visualización de Tarjetas Rápidas" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Elige si deseas agrupar las tarjetas rápidas por categorías" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InputControlBorderStyle}" Width="200">
                            <ComboBox x:Name="RapidCardsLayoutComboBox" FontSize="14" Padding="6,4" BorderThickness="0" SelectedIndex="{Binding SelectedRapidCardsLayoutIndex, Mode=TwoWay}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                                <ComboBoxItem Content="Sin divisiones"/>
                                <ComboBoxItem Content="Con divisiones por Categoría"/>
                            </ComboBox>
                        </Border>
                    </Grid>

                    <!--<Separator Background="#F0E6EC" Height="1" Margin="0,5,0,15"/>

                    

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Notificaciones de actualización" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                            <TextBlock Text="Recibir avisos cuando haya nuevas versiones" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#7ACB8A" CornerRadius="12" Width="44" Height="24" Cursor="Hand"/>
                    </Grid>-->
                </StackPanel>
            </Border>

            <!-- Preferencias de Impresión -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🖨️  Preferencias de Impresión" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Style="{StaticResource ToggleRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Modelo de Impresión" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                                <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+M" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Elige si deseas enviar tickets directamente o abrir la ventana de diálogo" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InputControlBorderStyle}" Width="300">
                            <ComboBox x:Name="PrintModelComboBox" FontSize="14" Padding="6,4" BorderThickness="0" SelectedIndex="{Binding SelectedPrintModelIndex, Mode=TwoWay}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                                <ComboBoxItem Content="Configurar A Una Sola Impresora"/>
                                <ComboBoxItem Content="Siempre Elegir Impresora de Destino En Cada Venta"/>
                            </ComboBox>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource ToggleRowStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPrintModelIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Impresora Destino" FontSize="14" FontWeight="Bold" Foreground="#4A3B47"/>
                                <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+P" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Selecciona la impresora para la impresión de tickets" FontSize="12" Foreground="#6B5A68"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource InputControlBorderStyle}" Width="180">
                            <ComboBox x:Name="PrinterComboBox" FontSize="14" Padding="6,4" BorderThickness="0" 
                                      ItemsSource="{Binding InstalledPrinters}" 
                                      SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Información del sistema -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ℹ️  Información del Sistema" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Versión" FontSize="13" Foreground="#6B5A68"/>
                        <TextBlock Grid.Column="1" Text="Beta 0.9.5" FontSize="13" FontWeight="Bold" Foreground="#4A3B47"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framework" FontSize="13" Foreground="#6B5A68"/>
                        <TextBlock Grid.Column="1" Text="NET 8.0 + WPF" FontSize="13" FontWeight="Bold" Foreground="#4A3B47"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Base de datos" FontSize="13" Foreground="#6B5A68"/>
                        <TextBlock Grid.Column="1" Text="SQLite (local) · Firestore (cloud)" FontSize="13" FontWeight="Bold" Foreground="#4A3B47"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dispositivo" FontSize="13" Foreground="#6B5A68"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="13" FontWeight="Bold" Foreground="#4A3B47"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
