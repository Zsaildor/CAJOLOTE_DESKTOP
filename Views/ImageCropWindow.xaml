<Window x:Class="Cajolote.Views.ImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar Imagen de Perfil" 
        Width="420" Height="530"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Use the same ModalButtonStyle defined in App.xaml or local style if App.xaml is not merged -->
    </Window.Resources>

    <Border Background="#FBF6F6" CornerRadius="16" BorderBrush="#E8C4D8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="310"/> <!-- Cropping Area -->
                <RowDefinition Height="Auto"/> <!-- Controls -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Recortar Imagen de Perfil" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" HorizontalAlignment="Center"/>
                <TextBlock Text="Arrastra para mover la imagen. Usa la rueda o el deslizador para hacer zoom." FontSize="10.5" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Cropping Area (fixed at 300x300) -->
            <Border Grid.Row="1" Background="#EDE7E7" CornerRadius="8" ClipToBounds="True" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#DCD4D4" BorderThickness="1">
                <Grid x:Name="CanvasContainer" ClipToBounds="True" Background="Transparent"
                      MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown"
                      MouseMove="CanvasContainer_MouseMove"
                      MouseLeftButtonUp="CanvasContainer_MouseLeftButtonUp"
                      MouseWheel="CanvasContainer_MouseWheel"
                      Cursor="SizeAll">
                    
                    <!-- Source image to crop -->
                    <Image x:Name="SourceImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale" ScaleX="1.0" ScaleY="1.0"/>
                                <TranslateTransform x:Name="ImgTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Semi-transparent overlay with a circular hole -->
                    <!-- Container is 300x300. We want a circle of diameter 220 in the center -->
                    <!-- Center is (150, 150). Radius is 110. Bounding box is (40, 40) to (260, 260) -->
                    <Path Fill="#95000000" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,300,300"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="150,150" RadiusX="110" RadiusY="110"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Crop border indicator -->
                    <Ellipse Width="220" Height="220" Stroke="#A78BFA" StrokeThickness="1.5" Opacity="0.8" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Controls (Slider) -->
            <StackPanel Grid.Row="2" Margin="0,15,0,15">
                <Grid Width="280" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="➖" FontSize="11" VerticalAlignment="Center" Foreground="#6B5A68"/>
                    <Slider Grid.Column="1" x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1" Margin="10,0" 
                            TickFrequency="0.1" ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" Text="➕" FontSize="11" VerticalAlignment="Center" Foreground="#6B5A68"/>
                </Grid>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancelar" Width="100" Height="32" Click="Cancel_Click" Margin="0,0,10,0"
                        Style="{StaticResource ModalButtonStyle}" Background="#FADBD8" Foreground="#C0392B"/>
                <Button Content="Aceptar" Width="100" Height="32" Click="Accept_Click"
                        Style="{StaticResource ModalButtonStyle}" Background="#7ACB8A" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
