<UserControl x:Class="Cajolote.Views.RegistrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="white"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera de la sección -->
        <Grid Grid.Row="0" Margin="5,0,5,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Registros de Ventas" FontSize="28" FontWeight="Bold" Foreground="#4A3B47"/>
                    <Border Margin="10,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ para desplazarte sin mouse/ratón" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Historial completo de transacciones" FontSize="14" Foreground="#6B5A68"/>
            </StackPanel>
        </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="5,0,5,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Width="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Buscar..." 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         FontSize="14" Padding="10,8" BorderThickness="0"
                                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                                <Border Grid.Column="1" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Ctrl+F" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="6" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="SearchTypeComboBox" SelectedIndex="{Binding SelectedSearchTypeIndex, Mode=TwoWay}" 
                                          materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                          FontSize="14" Width="140" Padding="5" BorderThickness="0"
                                          DropDownClosed="ComboBox_DropDownClosed">
                                    <ComboBoxItem Content="Por folio"/>
                                    <ComboBoxItem Content="Por monto total"/>
                                    <ComboBoxItem Content="Por producto"/>
                                </ComboBox>
                                <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Ctrl+O" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SearchControlBorderStyle}" CornerRadius="6" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="FilterComboBox" FontSize="14" Width="140" Padding="5" BorderThickness="0" SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                      DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBoxItem Content="Hoy"/>
                                <ComboBoxItem Content="Esta semana"/>
                                <ComboBoxItem Content="Este mes"/>
                                <ComboBoxItem Content="Mes anterior"/>
                                <ComboBoxItem Content="Este año"/>
                                <ComboBoxItem Content="Todos"/>
                            </ComboBox>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Ctrl+L" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid ClipToBounds="False">
                            <Button Content="📥 Exportar"
                                    Command="{Binding ExportarCommand}"
                                    Background="#4A4E59" Foreground="White"
                                    FontSize="14" Padding="15,5" BorderThickness="0"
                                    Cursor="Hand"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0">
                                <TextBlock Text="Ctrl+X" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="5, 0, 5, 30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <Border Background="#FF94A2" CornerRadius="8" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Folio" Style="{StaticResource TableHeaderStyle}" Grid.Column="0"/>
                                <TextBlock Text="Fecha" Style="{StaticResource TableHeaderStyle}" Grid.Column="1"/>
                                <TextBlock Text="Productos" Style="{StaticResource TableHeaderStyle}" Grid.Column="2"/>
                                <TextBlock Text="Total" Style="{StaticResource TableHeaderStyle}" Grid.Column="3"/>
                                <TextBlock Text="Estado" Style="{StaticResource TableHeaderStyle}" Grid.Column="4"/>
                            </Grid>
                        </Border>
                        <Separator Background="#E8C4D8" Height="1" Margin="0,0,0,3"/>
                    </StackPanel>
                    
                    <ListBox Grid.Row="1" x:Name="SalesListBox" ItemsSource="{Binding Sales}" Background="Transparent" BorderThickness="0" Focusable="True" SelectionMode="Single" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="10" Background="Transparent" Margin="0,0,0,8" SnapsToDevicePixels="true">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF0F2"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Expander Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id, StringFormat='#0000'}" Style="{StaticResource TableCellStyle}" Grid.Column="0"/>
                                                    <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource TableCellStyle}" Grid.Column="1"/>
                                                    <TextBlock Text="{Binding TotalProductsCount}" Style="{StaticResource TableCellStyle}" Grid.Column="2"/>
                                                    <TextBlock Text="{Binding Total, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="3" FontWeight="Bold"/>
                                                    <Grid Grid.Column="4">
                                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <!-- Estado: Pagado / Fiado -->
                                                            <!-- Pagado badge -->
                                                            <Border Background="#E8F5E9" CornerRadius="10" Padding="8,2" Margin="0,2" Height="22" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="Pagado" FontSize="10" FontWeight="Bold" Foreground="#2B9348" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Fiado badge -->
                                                            <Border Background="#FDF2E9" CornerRadius="10" Padding="8,2" Margin="0,2" Height="22" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#E76F51" VerticalAlignment="Center">
                                                                    <TextBlock.Text>
                                                                        <Binding Path="Note.CustomerName" StringFormat="Fiado ({0})" TargetNullValue="Fiado" FallbackValue="Fiado"/>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- IsSynced false badge -->
                                                            <Border Background="#F8F9FA" CornerRadius="10" Padding="8,2" Margin="0,2" Height="22" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSynced}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="No sincronizado" FontSize="10" FontWeight="Bold" Foreground="#ADB5BD" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- IsSynced true badge -->
                                                            <Border Background="#E8F4F8" CornerRadius="10" Padding="8,2" Margin="0,2" Height="22" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="Sincronizado" FontSize="10" FontWeight="Bold" Foreground="#3498DB" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- IsEdited badge -->
                                                            <Border Background="#F3E5F5" CornerRadius="10" Padding="8,2" Margin="0,2" Height="22" HorizontalAlignment="Left" ToolTip="{Binding EditedAt, StringFormat='Editado el {0:dd/MM/yyyy HH:mm}'}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="Editado" FontSize="10" FontWeight="Bold" Foreground="#7B2CBF" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" 
                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Enter" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>    
                                                </Grid>
                                            </Expander.Header>
                                            
                                            <StackPanel Margin="30,10,10,10">
                                                <Separator Background="#E8C4D8" Margin="0,0,0,10"/>
                                                <TextBlock Text="Detalles de la compra:" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding EditedAt, StringFormat='Registro editado {0:dd/MM/yyyy HH:mm}'}" FontSize="13" Foreground="#7B2CBF" FontWeight="Bold" Margin="0,0,0,10">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                                
                                                <ItemsControl ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="60"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding QuantityDisplay}" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Grid.Column="0"/>
                                                                <TextBlock Text="{Binding Product.Name}" FontSize="13" Foreground="#4A3B47" Grid.Column="1" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="13" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="2" TextAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                                     <!-- Botón Eliminar Venta -->
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,10,5" VerticalAlignment="Center">
                                                         <Button Content="❌ Eliminar Venta" 
                                                                 Command="{Binding DataContext.DeleteSaleFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Background="#FFE3E3" Foreground="#E5383B" 
                                                                 BorderThickness="0" Padding="10,5" 
                                                                 Cursor="Hand" FontWeight="Bold"/>
                                                         <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                             <TextBlock Text="Ctrl+Supr" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                         </Border>
                                                     </StackPanel>

                                                     <!-- Botón Editar Venta -->
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,10,5" VerticalAlignment="Center">
                                                         <StackPanel.Style>
                                                             <Style TargetType="StackPanel">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </StackPanel.Style>
                                                         <Button Content="✏️ Editar Venta" 
                                                                 Command="{Binding DataContext.EditSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Background="#E0EBFF" Foreground="#4361EE" 
                                                                 BorderThickness="0" Padding="10,5" 
                                                                 Cursor="Hand" FontWeight="Bold"/>
                                                         <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                             <TextBlock Text="Ctrl+E" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                         </Border>
                                                     </StackPanel>

                                                     <!-- Botón Marcar como Fiado -->
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,10,5" VerticalAlignment="Center">
                                                         <StackPanel.Style>
                                                             <Style TargetType="StackPanel">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </StackPanel.Style>
                                                         <Button Content="📝 Marcar como Fiado" 
                                                                 Command="{Binding DataContext.FiarVentaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Background="#FFECD1" Foreground="#F77F00" 
                                                                 BorderThickness="0" Padding="10,5" 
                                                                 Cursor="Hand" FontWeight="Bold"/>
                                                         <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                             <TextBlock Text="Ctrl+D" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                         </Border>
                                                     </StackPanel>

                                                     <!-- Botón Marcar como Pagado 
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,10,5" VerticalAlignment="Center">
                                                         <StackPanel.Style>
                                                             <Style TargetType="StackPanel">
                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </StackPanel.Style>
                                                         <Button Content="💵 Marcar como Pagado" 
                                                                 Command="{Binding DataContext.PagarVentaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Background="#D8F3DC" Foreground="#2D6A4F" 
                                                                 BorderThickness="0" Padding="10,5" 
                                                                 Cursor="Hand" FontWeight="Bold"/>
                                                         <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                             <TextBlock Text="Ctrl+A" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                         </Border>
                                                     </StackPanel> -->

                                                     <!-- Botón Reimprimir Ticket -->
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                                                         <StackPanel.Style>
                                                             <Style TargetType="StackPanel">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </StackPanel.Style>
                                                         <Button Content="🖨️ Reimprimir Ticket" 
                                                                 Command="{Binding DataContext.ReimprimirTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                 CommandParameter="{Binding}" 
                                                                 Background="#D8F3DC" Foreground="#2D6A4F" 
                                                                 BorderThickness="0" Padding="10,5" 
                                                                 Cursor="Hand" FontWeight="Bold"/>
                                                         <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" Margin="5,0,0,0" VerticalAlignment="Center">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                             <TextBlock Text="Ctrl+P" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                                                         </Border>
                                                     </StackPanel>
                                                 </WrapPanel>
                                                
                                                <TextBlock Text="Deuda manual cobrada (Sin detalles de productos)" FontSize="13" FontStyle="Italic" Foreground="#999" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander>
                                        <Separator Background="#F0E6EC" Height="1"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    <!-- Overlay de carga de registros (Tabla) -->
                    <Border Grid.RowSpan="2" Background="#60FFFFFF" Visibility="{Binding IsLoadingData, Converter={StaticResource BoolToVis}}" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="45" Height="45" Foreground="#FF94A2"/>
                            <TextBlock Text="Cargando registros..." Foreground="#4A3B47" FontSize="14" Margin="0,12,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
    <materialDesign:Snackbar MessageQueue="{Binding ErrorMessageQueue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>

    <!-- Modal overlay para reimprimir ticket -->
    <Grid x:Name="PrintModalGrid" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPrintModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <StackPanel>
                <TextBlock Text="Reimprimir Ticket" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="¿Desea reimprimir el ticket?" FontSize="16" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="No" Command="{Binding SkipPrintTicketCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Sí" Command="{Binding ConfirmPrintTicketCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay para exportar reporte -->
    <Grid x:Name="ExportModalGrid" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsExportModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <StackPanel>
                <TextBlock Text="Exportar Reporte" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="Seleccione la cantidad de registros que desea incluir en el archivo PDF:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,15" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <ComboBox ItemsSource="{Binding ExportQuantityOptions}" SelectedIndex="{Binding SelectedExportQuantityIndex}" FontSize="14" Padding="10" Margin="0,0,0,25" HorizontalAlignment="Center" Width="200" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="1" BorderBrush="#DCD4D4"/>

                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelExportCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Continuar" Command="{Binding ProceedExportCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay de advertencia para exportar Todos -->
    <Grid x:Name="ExportWarningModalGrid" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsExportWarningModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <StackPanel>
                <TextBlock Text="⚠️ Advertencia" FontSize="18" FontWeight="Bold" Foreground="#D35400" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="Ha seleccionado exportar TODOS los registros disponibles. Dependiendo de la cantidad, esta operación podría tardar varios minutos y el archivo generado podría ser pesado." FontSize="14" Foreground="#6B5A68" Margin="0,0,0,10" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="¿Está seguro de que desea continuar?" FontSize="14" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelExportWarningCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Sí, exportar" Command="{Binding ConfirmExportAllCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay para editar venta -->
    <Grid x:Name="EditModalGrid" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxHeight="600">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding SelectedSaleForEdit.Id, StringFormat='Editar Venta #{0:0000}'}" FontSize="20" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <!-- Lista de productos en la venta -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding EditingDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FBF6F6" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=C}" FontSize="12" Foreground="#4A4E59"/>
                                        </StackPanel>
                                        
                                        <!-- Cantidad con - y + y TextBox -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Command="{Binding DataContext.DecreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand"/>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0" TextAlignment="Center" FontSize="14" VerticalAlignment="Center"/>
                                            <Button Content="+" Command="{Binding DataContext.IncreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#D5F5E3" Foreground="#27AE60" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat=C}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        
                                        <Button Grid.Column="3" Command="{Binding DataContext.RemoveEditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" Margin="10,0,0,0" ToolTip="Quitar producto" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Total actualizable -->
                <Grid Grid.Row="2" Margin="0,5,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Foreground="#4A3B47"/>
                    <TextBlock Grid.Column="1" Text="{Binding EditingTotal, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="#7ACB8A"/>
                </Grid>
                
                <!-- Botones de Guardar / Cancelar / Eliminar todo -->
                <Grid Grid.Row="3" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Eliminar Venta" Command="{Binding DeleteSaleCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}"/>
                    <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelEditCommand}" Background="#E5E7EB" Foreground="#374151" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="4" Content="Guardar" Command="{Binding SaveEditCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- Modal overlay para confirmar eliminación de venta -->
    <Grid x:Name="DeleteModalGrid" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <StackPanel>
                <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SaleToDelete.Id, StringFormat='¿Está seguro de que desea eliminar por completo la venta #{0:0000}?'}" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteSaleCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmDeleteSaleCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Modal overlay para fiar (deuda) -->
    <Grid x:Name="CreditModal" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsCreditModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
        <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <StackPanel>
                <TextBlock Text="Fiar Venta a Cliente" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                <TextBlock Text="Selecciona la cuenta (nota) del cliente o crea una nueva:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,10" TextWrapping="Wrap"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                    <CheckBox x:Name="NewCreditAccountCheckBox" Content="Crear nueva cuenta / deudor" IsChecked="{Binding CreateNewCreditAccount}" FontSize="14" Foreground="#4A3B47"/>
                    <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="4,1,4,1.5" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Ctrl+N" FontSize="9" FontWeight="SemiBold" Foreground="#6B707E"/>
                    </Border>
                </StackPanel>

                <!-- Border para ComboBox -->
                <Border x:Name="CreditCustomerComboBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="CreditCustomerComboBoxBorder_IsVisibleChanged">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ComboBox x:Name="CreditCustomerComboBox" ItemsSource="{Binding AvailableNotes}" SelectedItem="{Binding SelectedNote}" materialDesign:HintAssist.Hint="Seleccionar cliente existente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="14" Padding="10,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerName}" FontWeight="Bold"/>
                                    <TextBlock Text=" (Deuda: "/>
                                    <TextBlock Text="{Binding Amount, StringFormat=C}"/>
                                    <TextBlock Text=")"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <!-- Border para TextBox -->
                <Border x:Name="NewCreditCustomerTextBoxBorder" CornerRadius="8" Background="White" Margin="0,0,0,20" IsVisibleChanged="NewCreditCustomerTextBoxBorder_IsVisibleChanged">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CreateNewCreditAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="NewCreditCustomerTextBox" Text="{Binding NewCreditCustomerName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nombre del cliente" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" FontSize="14" Padding="10,8"/>
                </Border>

                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCreditCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                    <Button Grid.Column="2" Content="Confirmar" Command="{Binding ConfirmCreditCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Overlay de carga asíncrona -->
    <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#90000000" Visibility="{Binding IsLoadingExport, Converter={StaticResource BoolToVis}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="60" Height="60" Foreground="White"/>
            <TextBlock Text="Generando reporte..." Foreground="White" FontSize="16" Margin="0,15,0,0" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Por favor espere, esto podría tomar un momento." Foreground="#E0E0E0" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Grid>
</UserControl>
