<UserControl x:Class="Cajolote.Views.EstadisticasTotalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
     <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B5A68"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Estadísticas Totales" FontSize="28" FontWeight="Bold"
                       Foreground="#4A3B47" Margin="0,0,0,5"/>
            <TextBlock Text="Resumen de rendimiento histórico consolidado" FontSize="14"
                       Foreground="#6B5A68" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Ver:" FontSize="14" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="MonthStatsRadio" Content="Este mes" IsChecked="False" Checked="MonthStatsRadio_Checked" VerticalAlignment="Center" Foreground="#4A3B47"/>
                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="5,0,20,0">
                    <TextBlock Text="Alt+M / Alt+7" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                </Border>
                
                <RadioButton x:Name="TotalStatsRadio" Content="Todo" IsChecked="True" VerticalAlignment="Center" Foreground="#4A3B47"/>
                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="5,0,0,0">
                    <TextBlock Text="Alt+T" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                </Border>
            </StackPanel>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
 
                 <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                     <StackPanel>
                         <TextBlock Text="Ventas Totales" Style="{StaticResource StatTitleStyle}"/>
                         <TextBlock Text="{Binding VentasTotales, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                     </StackPanel>
                 </Border>
 
                 <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                     <StackPanel>
                         <TextBlock Text="Ventas del Año" Style="{StaticResource StatTitleStyle}"/>
                         <TextBlock Text="{Binding VentasAnio, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                     </StackPanel>
                 </Border>
 
                 <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                     <StackPanel>
                         <TextBlock Text="Transacciones Totales" Style="{StaticResource StatTitleStyle}"/>
                         <TextBlock Text="{Binding TransaccionesTotales}" Style="{StaticResource StatValueStyle}"/>
                     </StackPanel>
                 </Border>
 
                 <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                     <StackPanel>
                         <TextBlock Text="Ticket Promedio (Histórico)" Style="{StaticResource StatTitleStyle}"/>
                         <TextBlock Text="{Binding TicketPromedio, StringFormat=C}" Style="{StaticResource StatValueStyle}"/>
                     </StackPanel>
                 </Border>
             </Grid>            <!-- Ventas por Mes (Este año) - Full Width -->
            <Border Style="{StaticResource CardStyle}" Margin="10,0,10,20" Height="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ventas por Mes (Este año)" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                    <lvc:CartesianChart
                        Grid.Row="1"
                        Series="{Binding VentasPorMesSeries}"
                        XAxes="{Binding VentasPorMesXAxes}"
                        YAxes="{Binding VentasPorMesYAxes}"
                        Margin="0,0,0,10">
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Horas Pico y Productos Más Vendidos - Side by Side -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="10,0,10,0" Height="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Horas Pico (Histórico)" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding PeakHoursSeries}"
                            XAxes="{Binding PeakHoursXAxes}"
                            YAxes="{Binding PeakHoursYAxes}"
                            Margin="0,0,0,10">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,10,0" Height="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Productos Más Vendidos (Histórico)" FontSize="16" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding TopProductsSeries}"
                            XAxes="{Binding TopProductsXAxes}"
                            YAxes="{Binding TopProductsYAxes}"
                            Margin="0,0,0,5">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- Ingresos por Categoría (Histórico) - Full Width -->
            <Border Style="{StaticResource CardStyle}" Height="350" Margin="10, 0, 10, 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with Title and Keyboard Shortcut Badge -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Ingresos por Categoría (Histórico)" FontSize="16" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="10,0,0,0">
                            <TextBlock Text="Ctrl+G para seleccionar/deseleccionar lista y ↑↓ para navegar" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                        </Border>
                    </StackPanel>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5.8*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4.2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Column 0: Donut Chart -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Gráfica" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            
                            <Grid Grid.Row="1">
                                <lvc:PieChart
                                    Series="{Binding CategorySeries}"
                                    LegendPosition="Hidden"
                                    Margin="0,0,0,0">
                                </lvc:PieChart>
                                
                                <!-- Center Overlay -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140" ClipToBounds="False">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryChartCenterTitle}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#6B5A68" 
                                                   TextAlignment="Center" 
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CategoryChartCenterValue}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold" 
                                                   Foreground="#4A3B47" 
                                                   TextAlignment="Center" 
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        
                        <!-- Column 1: Vertical Divider -->
                        <Border Grid.Column="1" Width="1" Background="#E8C4D8" Margin="15,5,15,10" VerticalAlignment="Stretch"/>
                        
                        <!-- Column 2: Selectable List -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Lista" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="5,0,0,8"/>
                            
                            <ListBox x:Name="CategoriesListBox" Grid.Row="1" ItemsSource="{Binding CategoryLegendItems}" SelectedItem="{Binding SelectedLegendItem}" Background="Transparent" BorderThickness="0" Focusable="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" CornerRadius="6" Padding="6,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="4,0,0,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFAEC0"/>
                                                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>-->
                                                                </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#FBF6F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="13" Foreground="#4A3B47" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RevenueDisplay}" FontSize="13" Foreground="#6B5A68" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
         </StackPanel>
     </ScrollViewer>
 </UserControl>
