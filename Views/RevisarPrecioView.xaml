<UserControl x:Class="Cajolote.Views.RevisarPrecioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Cajolote.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
             PreviewLostKeyboardFocus="UserControl_PreviewLostKeyboardFocus">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding EditProductCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <converters:ResourceKeyToIconConverter x:Key="ResourceKeyToIcon"/>
        <converters:IconKeyToFriendlyNameConverter x:Key="IconKeyToFriendlyName"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="IconCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBF6F6"/>
            <Setter Property="BorderBrush" Value="#E8C4D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF94A2"/>
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Margin="10, 0, 10, 0">
            <Border.Effect>
                <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Revisador de Precios" FontSize="24" FontWeight="Bold" Foreground="#4A4E59" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Badge instructivo sobre el TextBox -->
                <Border Background="#EDE7E7"
                        BorderBrush="#DCD4D4"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="#EDE7E7" BlurRadius="3" ShadowDepth="1" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BarcodeScan" Width="16" Height="16" Foreground="#6B707E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Escanea el código de barras o escríbelo"
                                   Foreground="#6B707E"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Style="{StaticResource InputControlBorderStyle}" Margin="0,0,0,6">
                    <TextBox x:Name="BarcodeTextBox"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="18" Padding="10,8" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Center"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CheckPriceCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <!-- Recordatorio debajo del TextBox -->
                <TextBlock Text="Recuerda dar enter para buscar" 
                           FontSize="12" 
                           Foreground="#887784" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,15"
                           FontStyle="Italic"/>

                <TextBlock Text="{Binding StatusMessage}" FontSize="16" Foreground="#4A4E59" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Border Background="white" CornerRadius="8" Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FoundProduct}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding FoundProduct.Name}" FontSize="22" FontWeight="Bold" Foreground="#4A4E59" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Grid HorizontalAlignment="Center" Margin="0,10,0,0" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FoundProduct.Price, StringFormat=C}" FontSize="48" FontWeight="Bold" Foreground="#7ACB8A" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center" ClipToBounds="False">
                                <Button Command="{Binding EditProductCommand}" Background="Transparent" Foreground="#ADB5BD" BorderThickness="0" Padding="0" ToolTip="Editar Producto (Ctrl+E)" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="Pencil" Width="28" Height="28"/>
                                </Button>
                                <!-- Badge de Atajo Ctrl+E -->
                                <Border Background="#EDE7E7"
                                        BorderBrush="#DCD4D4"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="5,1,5,1.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,20,-30,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#EDE7E7" BlurRadius="3" ShadowDepth="1" Opacity="0.15"/>
                                    </Border.Effect>
                                    <TextBlock Text="Ctrl+E"
                                               Foreground="#6B707E"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>        <!-- Modal overlay para agregar/editar producto -->
        <Grid x:Name="EditProductModal" Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVis}}" PreviewKeyDown="ProductModal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="ProductModalBorder" Style="{StaticResource CardStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Editar Producto"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddingProduct}" Value="True">
                                        <Setter Property="Text" Value="Registrar Producto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                            <RadioButton GroupName="ProductTypeRP" Content="Por Unidad" IsChecked="{Binding IsProductUnit}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+U" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ProductTypeRP" Content="A Granel" IsChecked="{Binding IsProductBulk}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+G" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White">
                            <TextBox x:Name="ModalBarcodeTextBox" materialDesign:HintAssist.Hint="Código de Barras" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" FontSize="14"/>
                        </Border>
                        <!-- Mostrar "Sin código" solo al registrar nuevo producto -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                            <CheckBox Content="Sin código" IsChecked="{Binding ProductHasNoBarcode}" IsEnabled="False" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAddingProduct}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="NameTextBox" materialDesign:HintAssist.Hint="Nombre del Producto" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsVisibleChanged="NameTextBox_IsVisibleChanged"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <ComboBox x:Name="CategoryComboBox" materialDesign:HintAssist.Hint="Categoría" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.CategoryId}" FontSize="14"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="PriceTextBox" materialDesign:HintAssist.Hint="{Binding PriceHint}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
                    </Border>

                    <!-- Selector Visual de Icono -->
                    <TextBlock Text="Icono del Producto (Opcional)" FontSize="12" Foreground="#887784" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previsualización del Icono Seleccionado -->
                        <Border Background="#FBF6F6" BorderBrush="#E8C4D8" BorderThickness="1.5" CornerRadius="8" Padding="10">
                            <Grid>
                                <!-- Estado: Sin Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="22" Height="22" Foreground="#887784" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sin ícono asignado" VerticalAlignment="Center" Foreground="#887784" FontSize="14"/>
                                </StackPanel>
                                
                                <!-- Estado: Con Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="{Binding SelectedProduct.IconKey, Converter={StaticResource ResourceKeyToIcon}}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedProduct.IconKey, Converter={StaticResource IconKeyToFriendlyName}}" VerticalAlignment="Center" Foreground="#4A4E59" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Botones de Acción -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <!-- Botón Editar/Buscar -->
                            <Button Command="{Binding OpenIconSelectorCommand}" Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="0" Width="36" Height="36" ToolTip="Seleccionar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                            </Button>
                            
                            <!-- Botón Eliminar (Solo visible si hay un ícono seleccionado) -->
                            <Button Command="{Binding RemoveIconCommand}" Background="#E67E80" Foreground="white" BorderThickness="0" Padding="0" Width="36" Height="36" Margin="8,0,0,0" ToolTip="Quitar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <CheckBox Content="Mostrar en accesos rápidos" IsChecked="{Binding SelectedProduct.IsQuickProduct}" IsEnabled="{Binding ProductHasBarcode}" Focusable="False" FontSize="14" Foreground="#4A3B47"/>
                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+R" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelProductCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Height="35" Focusable="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModalButtonStyle}">
                                    <Setter Property="IsCancel" Value="True"/>
                                    <Setter Property="Tag" Value="Esc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconSelectorOpen}" Value="True">
                                            <Setter Property="IsCancel" Value="False"/>
                                            <Setter Property="Tag" Value=""/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveProductCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S" Height="35" Focusable="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Modal overlay para seleccionar icono -->
        <Grid x:Name="IconSelectorModal" Background="#80000000" Visibility="{Binding IsIconSelectorOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="IconSelectorModalBorder" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxHeight="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Seleccionar Icono del Producto" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Text="Elige un icono de la galería para identificar este producto rápido." FontSize="13" Foreground="#887784" VerticalAlignment="Bottom" Margin="0,25,0,15"/>
                    
                    <!-- Galería de iconos -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,15">
                        <ItemsControl ItemsSource="{Binding AvailableIcons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Width="110" Height="90" Margin="6"
                                            Style="{StaticResource IconCardButtonStyle}">
                                        <Button.Content>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding Converter={StaticResource ResourceKeyToIcon}}" Width="36" Height="36" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Converter={StaticResource IconKeyToFriendlyName}}" 
                                                           FontSize="11" 
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                           TextAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Botón Cancelar -->
                    <Button Grid.Row="2" Content="Cancelar" Command="{Binding CloseIconSelectorCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True" HorizontalAlignment="Right" Width="100" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
