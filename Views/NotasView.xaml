<UserControl x:Class="Cajolote.Views.NotasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:models="clr-namespace:Cajolote.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="white"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActiveRowBadgeStyle" TargetType="Border" BasedOn="{StaticResource KeyboardShortcutStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" Focusable="True" FocusVisualStyle="{x:Null}" Padding="30" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Notas - Fiados" FontSize="28" FontWeight="Bold" Foreground="#4A3B47"/>
                        <TextBlock Text="Registro de compras pendientes por cobrar" FontSize="14" Foreground="#6B5A68"/>
                    </StackPanel>
                </Grid>

                <!-- Top section: Formulario on the left, Stats on the right -->
                <Grid x:Name="TopGrid" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColForm" Width="320"/>
                        <ColumnDefinition x:Name="ColStats" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RowForm" Height="*"/>
                        <RowDefinition x:Name="RowStats" Height="0"/>
                    </Grid.RowDefinitions>

                    <!-- Formulario -->
                    <Border x:Name="FormBorder" Grid.Column="0" Grid.Row="0" Margin="5,5,15,5" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF94A2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Registrar Deuda" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+E" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                </Border>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,0,15">
                                <Border Margin="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource KeyboardShortcutStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FormBorder, Path=IsKeyboardFocusWithin}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Ctrl+T" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Nuevo Cliente" IsChecked="{Binding IsNewCustomer}" Margin="0,0,15,0" Foreground="#6B5A68" FontWeight="Bold"/>
                                    <RadioButton Content="Cliente Existente" Foreground="#6B5A68" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Nombre del Cliente Nuevo -->
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15" Visibility="{Binding IsNewCustomer, Converter={StaticResource BoolToVis}}">
                                <TextBox x:Name="NewCustomerNameTextBox" materialDesign:HintAssist.Hint="Nombre del Cliente Nuevo" 
                                         Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="15" Padding="10,8" BorderThickness="0" 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                         Background="Transparent"/>
                            </Border>
                            
                            <!-- Seleccionar Cliente Existente -->
                            <Border CornerRadius="8" Background="White" Margin="0,0,0,15">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SearchControlBorderStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewCustomer}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ComboBox x:Name="ExistingCustomerComboBox" ItemsSource="{Binding Notes}" 
                                          SelectedItem="{Binding SelectedExistingCustomer}" 
                                          DisplayMemberPath="CustomerName" 
                                          materialDesign:HintAssist.Hint="Seleccionar Cliente Existente" 
                                          FontSize="15" Padding="10,6" BorderThickness="0" 
                                          materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                          Background="Transparent"
                                          GotFocus="ExistingCustomerComboBox_GotFocus"
                                          SelectionChanged="ExistingCustomerComboBox_SelectionChanged"/>
                            </Border>
                            
                            <!-- Monto de la Deuda -->
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                                <TextBox x:Name="NewAmountTextBox" materialDesign:HintAssist.Hint="Monto de la Deuda" 
                                         Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                         FontSize="15" Padding="10,8" BorderThickness="0" 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                         Background="Transparent"/>
                            </Border>

                            <!-- Motivo / Detalles Adicionales -->
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,25">
                                <TextBox x:Name="NewDetailsTextBox" materialDesign:HintAssist.Hint="Motivo / Detalles Adicionales" 
                                         Text="{Binding NewDetails, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="15" Padding="10,8" BorderThickness="0" 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                         Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Button x:Name="AddNoteButton" Content="Anotar Deuda" Command="{Binding AddNoteCommand}" Background="#D8F3DC" Foreground="#2D6A4F" FontSize="15" FontWeight="Bold" BorderThickness="0" Padding="10,5" materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand"/>
                                <Border Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource KeyboardShortcutStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FormBorder, Path=IsKeyboardFocusWithin}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Ctrl+S" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stats & Charts Container -->
                    <Grid x:Name="StatsContainerGrid" Grid.Column="1" Grid.Row="0" Margin="0,5,5,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Stats (horizontal row) -->
                        <Grid x:Name="MetricsGrid" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColMetric0" Width="*"/>
                                <ColumnDefinition x:Name="ColMetric1" Width="*"/>
                                <ColumnDefinition x:Name="ColMetric2" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowMetric0" Height="*"/>
                                <RowDefinition x:Name="RowMetric1" Height="0"/>
                                <RowDefinition x:Name="RowMetric2" Height="0"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="MetricCard0" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Total Fiado" FontSize="14" Foreground="#6B5A68"/>
                                    <TextBlock Text="{Binding TotalFiado, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#E76F51" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MetricCard1" Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Deudores Activos" FontSize="14" Foreground="#6B5A68"/>
                                    <TextBlock Text="{Binding DeudoresActivos}" FontSize="24" FontWeight="Bold" Foreground="#4A3B47" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MetricCard2" Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Deuda Promedio" FontSize="14" Foreground="#6B5A68"/>
                                    <TextBlock Text="{Binding DeudaPromedio, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#4A3B47" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 1: Bar Chart (Top 5 Deudores) full width -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="5,10,5,5" Height="225">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Top 5 Deudores Activos" FontSize="13" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,5"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding TopDebtorsSeries}" XAxes="{Binding TopDebtorsXAxes}" YAxes="{Binding TopDebtorsYAxes}" Margin="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Tabla ocupando todo el ancho -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5,0,5,20" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Border Style="{StaticResource CardStyle}" MinWidth="850" Margin="5, 0, 5, 0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Lista de Cuentas Activas" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+D" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                            </Border>
                        </StackPanel>
                        <Border Background="#FF94A2" CornerRadius="8" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cliente" Style="{StaticResource TableHeaderStyle}" Grid.Column="0"/>
                                <TextBlock Text="Deuda Total" Style="{StaticResource TableHeaderStyle}" Grid.Column="1"/>
                                <TextBlock Text="Abonado" Style="{StaticResource TableHeaderStyle}" Grid.Column="2"/>
                                <TextBlock Text="Faltante" Style="{StaticResource TableHeaderStyle}" Grid.Column="3"/>
                                <TextBlock Text="Desde" Style="{StaticResource TableHeaderStyle}" Grid.Column="4"/>
                                <TextBlock Text="Acciones" Style="{StaticResource TableHeaderStyle}" Grid.Column="5"/>
                            </Grid>
                        </Border>
                        <Separator Background="#FF94A2" Height="1" Margin="0,0,0,3"/>
                        
                        <ListBox x:Name="ActiveNotesListBox" ItemsSource="{Binding Notes}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border BorderBrush="#E8C4D8" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="6" Background="Transparent" Padding="5,4" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF0F2"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Expander Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                                <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource TableCellStyle}" FontWeight="Bold"/>
                                                        <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Enter" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Ctrl+Enter (Detalles)" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Amount, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="1" FontWeight="Bold" Foreground="#6B5A68"/>
                                                    <TextBlock Text="{Binding PaidAmount, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="2" FontWeight="Bold" Foreground="#27AE60"/>
                                                    <TextBlock Text="{Binding Faltante, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="3" FontWeight="Bold" Foreground="#E74C3C"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" Style="{StaticResource TableCellStyle}" Grid.Column="4"/>
                                                     <WrapPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                                                                <Button Command="{Binding DataContext.RequestAddDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="+ Deuda" Background="#E0EBFF" Foreground="#4361EE"  FontSize="11" FontWeight="Bold" Padding="10,0" Height="24" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand"/>
                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Ctrl+A" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                                                                <Button Command="{Binding DataContext.RequestSettleNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Cobrar" Background="#D8F3DC" Foreground="#2D6A4F" FontSize="11" FontWeight="Bold" Padding="10,0" Height="24" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand"/>
                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Ctrl+C" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                                <Button Command="{Binding DataContext.RequestFullDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Eliminar" Background="#FFE3E3" Foreground="#E5383B" FontSize="11" FontWeight="Bold" Padding="10,0" Height="24" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand"/>
                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Ctrl+Supr" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                     </WrapPanel>
                                                </Grid>
                                        </Expander.Header>
                                                
                                                <!-- Contenido expandido con el detalle de las deudas y ventas -->
                                                <StackPanel Margin="30,10,10,10">
                                                    <TextBlock Text="Detalle de movimientos de la cuenta (Deudas manuales y Ventas):" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,5,0,10"/>
                                                    
                                                    <ListBox x:Name="InnerDetailsListBox" ItemsSource="{Binding AllDetails}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                <EventSetter Event="GotFocus" Handler="InnerListBoxItem_GotFocus"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="4" Background="Transparent" Padding="5" SnapsToDevicePixels="true" Margin="0,0,0,5">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF5F6"/>
                                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                                                </MultiDataTrigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        
                                                        <ListBox.Resources>
                                                            <!-- Plantilla para ManualDebt -->
                                                            <DataTemplate DataType="{x:Type models:ManualDebt}">
                                                                <Border Background="#FDFEFE" BorderBrush="#E8C4D8" BorderThickness="1" CornerRadius="8" Padding="10">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Date, StringFormat='g'}" FontSize="12" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="0" VerticalAlignment="Center"/>
                                                                            
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <TextBlock Text="{Binding Amount, StringFormat='Total Manual: {0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center"/>
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Manual" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Enter (Editar)" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Supr (Eliminar)" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            
                                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Button Command="{Binding DataContext.EditManualDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Padding="0" Margin="0,0,8,0" ToolTip="Editar Deuda" Height="20" Width="20" Cursor="Hand">
                                                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                                                                </Button>
                                                                                <Button Command="{Binding DataContext.DeleteManualDebtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Eliminar Deuda" Height="20" Width="20" Cursor="Hand">
                                                                                    <materialDesign:PackIcon Kind="TrashCan" Width="16" Height="16"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Separator Background="#E8C4D8" Margin="0,5"/>
                                                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#4A3B47" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                            
                                                            <!-- Plantilla para Sale -->
                                                            <DataTemplate DataType="{x:Type models:Sale}">
                                                                <Border Background="#F8F0F5" CornerRadius="8" Padding="10">
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Date, StringFormat='g'}" FontSize="12" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="0" VerticalAlignment="Center"/>
                                                                            
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <TextBlock Text="{Binding Total, StringFormat='Total Venta: {0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center"/>
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Venta" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Enter (Editar)" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="Supr (Eliminar)" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            
                                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Button Command="{Binding DataContext.EditLinkedSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Padding="0" Margin="0,0,8,0" ToolTip="Editar Venta" Height="20" Width="20" Cursor="Hand">
                                                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                                                                </Button>
                                                                                <Button Command="{Binding DataContext.DeleteLinkedSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Eliminar Venta" Height="20" Width="20" Cursor="Hand">
                                                                                    <materialDesign:PackIcon Kind="TrashCan" Width="16" Height="16"/>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <Separator Background="#E8C4D8" Margin="0,5"/>
                                                                        
                                                                        <ItemsControl ItemsSource="{Binding Details}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="60"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="70"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding QuantityDisplay}" FontSize="12" Foreground="#6B5A68" Grid.Column="0"/>
                                                                                        <TextBlock Text="{Binding Product.Name}" FontSize="12" Foreground="#4A3B47" Grid.Column="1" TextWrapping="Wrap"/>
                                                                                        <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="12" Foreground="#4A3B47" Grid.Column="2" TextAlignment="Right"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                            
                                                            <!-- Plantilla para PaymentFormItem -->
                                                            <DataTemplate DataType="{x:Type models:PaymentFormItem}">
                                                                <Border CornerRadius="8" Padding="10" Background="#F4F6F7" BorderBrush="Transparent" BorderThickness="1" Margin="0,5,0,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="Registrar Abono a Cuenta:" FontSize="13" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                                                            
                                                                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Width="120" VerticalAlignment="Center">
                                                                                <TextBox x:Name="AbonoTextBox" 
                                                                                         materialDesign:HintAssist.Hint="Monto" 
                                                                                         Text="{Binding DataContext.AbonoAmount, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="13" 
                                                                                         Padding="8,5" 
                                                                                         BorderThickness="0" 
                                                                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                                                                         Background="Transparent"
                                                                                         VerticalAlignment="Center"
                                                                                         PreviewKeyDown="AbonoTextBox_PreviewKeyDown"
                                                                                         GotFocus="AbonoTextBox_GotFocus"/>
                                                                            </Border>
                                                                            
                                                                            <Grid Margin="15,0,0,0" VerticalAlignment="Center">
                                                                                <Button Command="{Binding DataContext.AddAbonoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                                        CommandParameter="{Binding Note}"
                                                                                        Content="Aplicar Abono" 
                                                                                        Background="#D8F3DC" 
                                                                                        Foreground="#2D6A4F" 
                                                                                        FontSize="11" 
                                                                                        FontWeight="Bold" 
                                                                                        Padding="12,0" 
                                                                                        Height="28" 
                                                                                        BorderThickness="0" 
                                                                                        materialDesign:ButtonAssist.CornerRadius="6" 
                                                                                        Cursor="Hand"
                                                                                        Focusable="False"/>
                                                                                <Border x:Name="AbonoEnterBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                                                    <TextBlock Text="Enter" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="AbonoTextBox" Property="IsFocused" Value="True">
                                                                        <Setter TargetName="AbonoEnterBadge" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.Resources>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                    </StackPanel>
                </Border>
            </ScrollViewer>

                <!-- Historial de Cuentas Liquidadas -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5,20,5,5" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Border Style="{StaticResource CardStyle}" MinWidth="850" Margin="5, 0, 5, 0">
                    <Grid>
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                    <TextBlock Text="Historial de Cuentas Liquidadas" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource KeyboardShortcutStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl+H" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🗑️ Borrar Todo el Historial" 
                                        Command="{Binding RequestDeleteAllPaidNotesCommand}" 
                                        Background="#FFE3E3" Foreground="#E5383B" 
                                        BorderThickness="0" Padding="12,5" Height="32"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        Cursor="Hand" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="#A78BFA" CornerRadius="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cliente" Style="{StaticResource TableHeaderStyle}" Grid.Column="0"/>
                                    <TextBlock Text="Total Liquidado" Style="{StaticResource TableHeaderStyle}" Grid.Column="1"/>
                                    <TextBlock Text="Desde" Style="{StaticResource TableHeaderStyle}" Grid.Column="2"/>
                                    <TextBlock Text="Acciones" Style="{StaticResource TableHeaderStyle}" Grid.Column="3"/>
                                </Grid>
                            </Border>
                            <Separator Background="#A78BFA" Height="1" Margin="0,0,0,3"/>
                            
                            <ListBox x:Name="PaidNotesListBox" ItemsSource="{Binding PaidNotes}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border BorderBrush="#E8C4D8" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,0,0,5">
                                                        <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="6" Background="Transparent" Padding="5,4" SnapsToDevicePixels="true">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#F5F3FF"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FAF8FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="240"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CustomerName}" Style="{StaticResource TableCellStyle}" FontWeight="Bold"/>
                                                            <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Enter" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Amount, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="1" FontWeight="Bold" Foreground="#27AE60"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" Style="{StaticResource TableCellStyle}" Grid.Column="2"/>
                                                        
                                                        <WrapPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,8,2">
                                                                <Button Command="{Binding DataContext.ReprintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Reimprimir" Background="#D8F3DC" Foreground="#2D6A4F" FontSize="11" FontWeight="Bold" Padding="10,0" Height="24" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand"/>
                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Ctrl+P" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                                <Button Command="{Binding DataContext.RequestPermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Eliminar" Background="#FFE3E3" Foreground="#E5383B" FontSize="11" FontWeight="Bold" Padding="10,0" Height="24" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" Cursor="Hand"/>
                                                                <Border Style="{StaticResource ActiveRowBadgeStyle}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Ctrl+Supr" Style="{StaticResource KeyboardShortcutTextStyle}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Expander.Header>
                                                
                                                <!-- Contenido expandido similar al anterior pero sin controles de abono -->
                                                <StackPanel Margin="30,10,10,10">
                                                    <!-- Deudas manuales -->
                                                    <TextBlock Text="Deudas agregadas manualmente:" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,5,0,5">
                                                        <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding ManualDebts.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                     
                                                     <ItemsControl ItemsSource="{Binding ManualDebts}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Border Background="#FDFEFE" BorderBrush="#E8C4D8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                     <StackPanel>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="*"/>
                                                                                 <ColumnDefinition Width="Auto"/>
                                                                             </Grid.ColumnDefinitions>
                                                                             <TextBlock Text="{Binding Date, StringFormat='g'}" FontSize="12" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="0"/>
                                                                             <TextBlock Text="{Binding Amount, StringFormat='Total Manual: {0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#E74C3C" Grid.Column="1"/>
                                                                         </Grid>
                                                                         <Separator Background="#E8C4D8" Margin="0,5"/>
                                                                         <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#4A3B47" TextWrapping="Wrap"/>
                                                                     </StackPanel>
                                                                 </Border>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
 
                                                     <!-- Ventas fiadas -->
                                                     <TextBlock Text="Ventas asociadas a esta deuda:" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,5,0,5">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Sales.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                     
                                                     <ItemsControl ItemsSource="{Binding Sales}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Border Background="#F8F0F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                     <StackPanel>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="*"/>
                                                                                 <ColumnDefinition Width="Auto"/>
                                                                             </Grid.ColumnDefinitions>
                                                                             <TextBlock Text="{Binding Date, StringFormat='g'}" FontSize="12" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="0"/>
                                                                             <TextBlock Text="{Binding Total, StringFormat='Total Venta: {0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#E74C3C" Grid.Column="1"/>
                                                                         </Grid>
                                                                         <Separator Background="#E8C4D8" Margin="0,5"/>
                                                                         
                                                                         <ItemsControl ItemsSource="{Binding Details}">
                                                                             <ItemsControl.ItemTemplate>
                                                                                 <DataTemplate>
                                                                                     <Grid Margin="0,2">
                                                                                         <Grid.ColumnDefinitions>
                                                                                             <ColumnDefinition Width="60"/>
                                                                                             <ColumnDefinition Width="*"/>
                                                                                             <ColumnDefinition Width="70"/>
                                                                                         </Grid.ColumnDefinitions>
                                                                                         <TextBlock Text="{Binding QuantityDisplay}" FontSize="12" Foreground="#6B5A68" Grid.Column="0"/>
                                                                                         <TextBlock Text="{Binding Product.Name}" FontSize="12" Foreground="#4A3B47" Grid.Column="1" TextWrapping="Wrap"/>
                                                                                         <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="12" Foreground="#4A3B47" Grid.Column="2" TextAlignment="Right"/>
                                                                                     </Grid>
                                                                                 </DataTemplate>
                                                                             </ItemsControl.ItemTemplate>
                                                                         </ItemsControl>
                                                                     </StackPanel>
                                                                 </Border>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>

                                                     <!-- Ventas históricas -->
                                                     <TextBlock Text="Ventas archivadas asociadas a esta deuda:" FontSize="13" FontWeight="Bold" Foreground="#6B5A68" Margin="0,5,0,5">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding HistoricalSales.Count}" Value="0">
                                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                     
                                                     <ItemsControl ItemsSource="{Binding HistoricalSales}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <Border Background="#F8F0F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                     <StackPanel>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="*"/>
                                                                                 <ColumnDefinition Width="Auto"/>
                                                                             </Grid.ColumnDefinitions>
                                                                             <TextBlock Text="{Binding Date, StringFormat='g'}" FontSize="12" FontWeight="Bold" Foreground="#4A3B47" Grid.Column="0"/>
                                                                             <TextBlock Text="{Binding Total, StringFormat='Total Venta: {0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#E74C3C" Grid.Column="1"/>
                                                                         </Grid>
                                                                         <Separator Background="#E8C4D8" Margin="0,5"/>
                                                                         
                                                                         <ItemsControl ItemsSource="{Binding Details}">
                                                                             <ItemsControl.ItemTemplate>
                                                                                 <DataTemplate>
                                                                                     <Grid Margin="0,2">
                                                                                         <Grid.ColumnDefinitions>
                                                                                             <ColumnDefinition Width="60"/>
                                                                                             <ColumnDefinition Width="*"/>
                                                                                             <ColumnDefinition Width="70"/>
                                                                                         </Grid.ColumnDefinitions>
                                                                                         <TextBlock Text="{Binding QuantityDisplay}" FontSize="12" Foreground="#6B5A68" Grid.Column="0"/>
                                                                                         <TextBlock Text="{Binding Product.Name}" FontSize="12" Foreground="#4A3B47" Grid.Column="1" TextWrapping="Wrap"/>
                                                                                         <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="12" Foreground="#4A3B47" Grid.Column="2" TextAlignment="Right"/>
                                                                                     </Grid>
                                                                                 </DataTemplate>
                                                                             </ItemsControl.ItemTemplate>
                                                                         </ItemsControl>
                                                                     </StackPanel>
                                                                 </Border>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </StackPanel>
                                             </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <StackPanel Margin="0,15,0,5" Visibility="{Binding HasMorePaidNotes, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding LoadMorePaidNotesCommand}" Content="Ver más" Width="150" Background="#F3E8FF" Foreground="#7C3AED" BorderThickness="0" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="18">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModalButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingMorePaidNotes}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Value="0" Width="24" Height="24" Foreground="#7C3AED" Visibility="{Binding IsLoadingMorePaidNotes, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Loader Overlay -->
                        <Grid Background="#B0FFFFFF" Visibility="{Binding IsDeletingAllPaidNotes, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="50" Height="50" Foreground="#A78BFA" Margin="0,0,0,10"/>
                                <TextBlock Text="Eliminando registros..." FontSize="14" FontWeight="SemiBold" Foreground="#4A3B47" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal overlay para confirmar cobro de cuenta -->
        <Grid Background="#80000000" Visibility="{Binding IsConfirmSettleOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <StackPanel>
                    <TextBlock Text="Confirmar Cobro" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                    <TextBlock Text="¿Está seguro de que desea cobrar y liquidar la cuenta de:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NoteToSettle.CustomerName}" FontSize="15" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding NoteToSettle.Faltante, StringFormat='Monto pendiente: {0:C}'}" FontSize="14" Foreground="#E74C3C" Margin="0,0,0,20"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelSettleNoteCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Confirmar" Command="{Binding ConfirmSettleNoteCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para imprimir comprobante de liquidación -->
        <Grid Background="#80000000" Visibility="{Binding IsPrintReceiptModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <StackPanel>
                    <TextBlock Text="Comprobante de Liquidación" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="¿Desea imprimir el comprobante de liquidación?" FontSize="16" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="No" Command="{Binding SkipPrintReceiptCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Sí" Command="{Binding ConfirmPrintReceiptCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación permanente de cuenta -->
        <Grid Background="#80000000" Visibility="{Binding IsConfirmPermanentDeleteOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <StackPanel>
                    <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                    <TextBlock Text="¿Está seguro de que desea eliminar permanentemente la cuenta archivada de:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NoteToPermanentDelete.CustomerName}" FontSize="15" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                    <TextBlock Text="Esta acción es irreversible y borrará todo el historial relacionado con esta cuenta." FontSize="12" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,20" TextWrapping="Wrap"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelPermanentDeleteCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmPermanentDeleteCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para editar deudas manuales -->
        <Grid Background="#80000000" Visibility="{Binding IsEditManualDebtOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Editar Deuda Manual" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="EditManualDebtAmountTextBox" materialDesign:HintAssist.Hint="Monto de la Deuda" 
                                 Text="{Binding EditingManualDebtAmount, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" Padding="10,8" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 Background="Transparent"
                                 IsVisibleChanged="EditManualDebtAmountTextBox_IsVisibleChanged"/>
                    </Border>
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,25">
                        <TextBox x:Name="EditManualDebtDetailsTextBox" materialDesign:HintAssist.Hint="Motivo / Detalles" 
                                 Text="{Binding EditingManualDebtDetails, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" Padding="10,8" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </Border>
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelEditManualDebtCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveEditManualDebtCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para editar venta vinculada -->
        <Grid Background="#80000000" Visibility="{Binding IsEditSaleOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxHeight="600" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{Binding SelectedSaleForEdit.Id, StringFormat='Editar Venta #{0:0000}'}" FontSize="20" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <ListBox x:Name="EditingSaleDetailsListBox" Grid.Row="1" ItemsSource="{Binding EditingDetails}" Background="Transparent" BorderThickness="0" Focusable="True" HorizontalContentAlignment="Stretch" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="EditingSaleDetailsListBox_PreviewKeyDown" IsVisibleChanged="EditingSaleDetailsListBox_IsVisibleChanged" Margin="0,0,0,15">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" Padding="0" SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                 <Border x:Name="ItemBorder" CornerRadius="8" Padding="10">
                                     <Border.Style>
                                         <Style TargetType="Border">
                                             <Setter Property="Background" Value="#FBF6F6"/>
                                             <Setter Property="BorderBrush" Value="Transparent"/>
                                             <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                             <Style.Triggers>
                                                 <MultiDataTrigger>
                                                     <MultiDataTrigger.Conditions>
                                                         <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                         <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                     </MultiDataTrigger.Conditions>
                                                     <Setter Property="Background" Value="#FFF0F2"/>
                                                     <Setter Property="BorderBrush" Value="#FFAEC0"/>
                                                 </MultiDataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </Border.Style>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="135"/>
                                             <ColumnDefinition Width="70"/>
                                             <ColumnDefinition Width="35"/>
                                         </Grid.ColumnDefinitions>
                                         
                                         <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                             <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" TextWrapping="Wrap"/>
                                             <TextBlock Text="{Binding UnitPrice, StringFormat=C}" FontSize="12" Foreground="#4A4E59"/>
                                         </StackPanel>
                                         
                                         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                             <Grid>
                                                 <Button Content="-" Command="{Binding DataContext.DecreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand" Focusable="False"/>
                                                 <Border x:Name="MinusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="-" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                             <Grid Margin="6,0">
                                                 <TextBox x:Name="QtyTextBox" Text="{Binding QuantityString, UpdateSourceTrigger=PropertyChanged}" Width="50" TextAlignment="Center" FontSize="14" VerticalAlignment="Center" Focusable="True" BorderThickness="1.5" Background="White" Padding="0,2" PreviewKeyDown="QtyTextBox_PreviewKeyDown">
                                                     <TextBox.Style>
                                                         <Style TargetType="TextBox">
                                                             <Setter Property="BorderBrush" Value="#CED4DA"/>
                                                             <Style.Triggers>
                                                                 <Trigger Property="IsFocused" Value="True">
                                                                     <Setter Property="BorderBrush" Value="#FF94A2"/>
                                                                 </Trigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBox.Style>
                                                 </TextBox>
                                                 <Border x:Name="QtyBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="Q" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                             <Grid>
                                                 <Button Content="+" Command="{Binding DataContext.IncreaseEditQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Width="24" Height="24" Background="#D5F5E3" Foreground="#27AE60" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="12" FontSize="16" Cursor="Hand" Focusable="False"/>
                                                 <Border x:Name="PlusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                     <TextBlock Text="+" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                                 </Border>
                                             </Grid>
                                         </StackPanel>
                                         
                                         <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat=C}" FontSize="14" FontWeight="Bold" Foreground="#4A4E59" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                         
                                         <Grid Grid.Column="3" HorizontalAlignment="Right">
                                             <Button Command="{Binding DataContext.RemoveEditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Quitar producto" Cursor="Hand" Focusable="False">
                                                 <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                             </Button>
                                             <Border x:Name="RemoveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" IsHitTestVisible="False" Visibility="Collapsed">
                                                 <TextBlock Text="Supr" FontSize="8" FontWeight="SemiBold" Foreground="#6B707E"/>
                                             </Border>
                                         </Grid>
                                     </Grid>
                                 </Border>
                                 <DataTemplate.Triggers>
                                     <MultiDataTrigger>
                                         <MultiDataTrigger.Conditions>
                                             <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                             <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                         </MultiDataTrigger.Conditions>
                                         <Setter TargetName="MinusBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="PlusBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="QtyBadge" Property="Visibility" Value="Visible"/>
                                         <Setter TargetName="RemoveBadge" Property="Visibility" Value="Visible"/>
                                     </MultiDataTrigger>
                                 </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Grid Grid.Row="2" Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Foreground="#4A3B47"/>
                        <TextBlock Grid.Column="1" Text="{Binding EditingTotal, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="#7ACB8A"/>
                    </Grid>
                    
                    <Grid Grid.Row="3" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Eliminar Venta" Command="{Binding DeleteSaleFromEditCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}"/>
                        <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelEditSaleCommand}" Background="#E5E7EB" Foreground="#374151" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="4" Content="Guardar" Command="{Binding SaveEditSaleCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación de venta vinculada -->
        <Grid Background="#80000000" Visibility="{Binding IsDeleteSaleConfirmationOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                <StackPanel>
                    <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SaleToDelete.Id, StringFormat='¿Está seguro de que desea eliminar por completo la venta #{0:0000} de la base de datos?'}" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteSaleCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmDeleteSaleCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación completa de cuenta activa -->
        <Grid Background="#80000000" Visibility="{Binding IsConfirmFullDeleteOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <StackPanel>
                    <TextBlock Text="Eliminar Cuenta Activa" FontSize="18" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,15"/>
                    <TextBlock Text="¿Está seguro de que desea eliminar por completo la cuenta de deuda activa de:" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NoteForFullDelete.CustomerName}" FontSize="15" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,10"/>
                    <TextBlock Text="¡ADVERTENCIA! Esta acción borrará permanentemente todas las deudas manuales y ventas vinculadas de esta cuenta (se eliminarán de la base de datos y no se registrarán como cobradas)." FontSize="12" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,20" TextWrapping="Wrap"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelFullDeleteNoteCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar Todo" Command="{Binding ConfirmFullDeleteNoteCommand}" Background="#E74C3C" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para agregar deuda a cliente existente (deshabilitado para edición) -->
        <Grid Background="#80000000" Visibility="{Binding IsAddDebtModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Agregar Deuda" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15"/>
                    
                    <Border CornerRadius="8" Background="#F1F1F1" Margin="0,0,0,15" BorderBrush="#CED4DA" BorderThickness="1.5">
                        <TextBox materialDesign:HintAssist.Hint="Cliente" 
                                 Text="{Binding SelectedNoteForAddDebt.CustomerName, Mode=OneWay}" 
                                 FontSize="15" Padding="10,8" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 Background="Transparent" IsEnabled="False"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="AddDebtAmountTextBox" materialDesign:HintAssist.Hint="Monto de la Deuda" 
                                 Text="{Binding AddDebtAmount, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" Padding="10,8" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 Background="Transparent"
                                 IsVisibleChanged="AddDebtAmountTextBox_IsVisibleChanged"/>
                    </Border>

                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,25">
                        <TextBox x:Name="AddDebtDetailsTextBox" materialDesign:HintAssist.Hint="Motivo / Detalles Adicionales" 
                                 Text="{Binding AddDebtDetails, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" Padding="10,8" BorderThickness="0" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </Border>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelAddDebtCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Aceptar" Command="{Binding ConfirmAddDebtCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación de todas las deudas liquidadas -->
        <Grid Background="#80000000" Visibility="{Binding IsConfirmDeleteAllPaidOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <StackPanel>
                    <TextBlock Text="Confirmar Eliminación Total" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="¿Está seguro de que desea eliminar permanentemente todas las cuentas liquidadas?" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,5" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Esta acción no se puede deshacer y romperá los vínculos con todas las ventas asociadas." FontSize="13" FontStyle="Italic" Foreground="#C0392B" Margin="0,0,0,25" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteAllPaidNotesCommand}" Background="#E5E7EB" Foreground="#374151" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar Todo" Command="{Binding ConfirmDeleteAllPaidNotesCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Snackbar de Errores/Notificaciones -->
        <materialDesign:Snackbar MessageQueue="{Binding ErrorMessageQueue}" HorizontalAlignment="Center" Background="#D8F3DC" Foreground="#2D6A4F" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
