<UserControl x:Class="Cajolote.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Cajolote.Converters"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewLostKeyboardFocus="UserControl_PreviewLostKeyboardFocus">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ResourceKeyToIconConverter x:Key="ResourceKeyToIcon"/>
        <converters:IconKeyToFriendlyNameConverter x:Key="IconKeyToFriendlyName"/>
        <converters:ZeroToEmptyStringConverter x:Key="ZeroToEmptyString"/>
        
        <Style x:Key="SearchControlBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000020" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="white"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4A3B47"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBF6F6"/>
            <Setter Property="BorderBrush" Value="#E8C4D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#4A4E59"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF94A2"/>
                    <Setter Property="BorderBrush" Value="#FF94A2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera de la sección (afuera de los cards) -->
        <StackPanel Grid.Row="0" Margin="5,0,5,20">
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding InventoryTitle}" FontSize="28" FontWeight="Bold" Foreground="#4A3B47"/>
                    <Border Margin="10,0,0,0" Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1.5" CornerRadius="5" Padding="5,1,5,1.5" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ para desplazarte sin mouse/ratón" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Administración y control de inventario de la tienda" FontSize="14" Foreground="#6B5A68"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Content="+ Nuevo Producto" Command="{Binding AddNewCommand}" Background="#D8F3DC" Foreground="#2D6A4F" BorderThickness="0" Cursor="Hand" Padding="15,8" materialDesign:ButtonAssist.CornerRadius="8"/>
                    <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+P" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Content="+ Nueva Categoría" Command="{Binding AddNewCategoryCommand}" Background="#E0EBFF" Foreground="#4361EE"  BorderThickness="0" Cursor="Hand" Padding="15,8" materialDesign:ButtonAssist.CornerRadius="8"/>
                    <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+G" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Content="{Binding ManageButtonText}" Command="{Binding ToggleManageCommand}" Background="#FFECD1" Foreground="#F77F00" BorderThickness="0" Cursor="Hand" Padding="15,8" materialDesign:ButtonAssist.CornerRadius="8"/>
                    <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+T" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Buscador y Filtros (dentro de su propio card) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="5,0,5,15" Visibility="{Binding IsManagingProducts, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Width="250">
                                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Buscar producto..." 
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         FontSize="14" Padding="10,8" BorderThickness="0" PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                            </Border>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+F" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="6">
                                <ComboBox x:Name="SearchTypeComboBox" ItemsSource="{Binding SearchTypes}" 
                                           SelectedItem="{Binding SelectedSearchType}" 
                                           materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                           FontSize="14" Width="150" Padding="5" BorderThickness="0"
                                           DropDownClosed="ComboBox_DropDownClosed"/>
                            </Border>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+O" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        
                        <TextBlock Text="Mostrar:" VerticalAlignment="Center" Foreground="#4A3B47" Margin="15,0,5,0" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="6">
                                <ComboBox x:Name="LimitComboBox" ItemsSource="{Binding LimitOptions}" 
                                           SelectedItem="{Binding SelectedLimit}" 
                                           materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                           FontSize="14" Width="100" Padding="5" BorderThickness="0"
                                           DropDownClosed="ComboBox_DropDownClosed"/>
                            </Border>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+L" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Listado de Datos (dentro de su card principal) -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="5,0,5,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cargador lineal para la base de datos -->
                        <ProgressBar Grid.Row="0" Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     Value="0"
                                     IsIndeterminate="True"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="4"
                                     VerticalAlignment="Top"
                                     Panel.ZIndex="10"
                                     Margin="0,0,0,10"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                        <!-- Listado de Productos -->
                        <Grid Grid.Row="1" Visibility="{Binding IsManagingProducts, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                            <!-- Cabeza de Tabla de Productos -->
                            <Border Background="#FF94A2" CornerRadius="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Código" Style="{StaticResource TableHeaderStyle}" Grid.Column="0"/>
                                    <TextBlock Text="Nombre" Style="{StaticResource TableHeaderStyle}" Grid.Column="1"/>
                                    <TextBlock Text="Categoría" Style="{StaticResource TableHeaderStyle}" Grid.Column="2"/>
                                    <TextBlock Text="Precio" Style="{StaticResource TableHeaderStyle}" Grid.Column="3"/>
                                    <TextBlock Text="Acciones" Style="{StaticResource TableHeaderStyle}" Grid.Column="4" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Separator Background="#E8C4D8" Height="1" Margin="0,0,0,3"/>
                        </StackPanel>

                        <!-- Listado de Productos -->
                        <ListBox Grid.Row="1" x:Name="ProductsListBox" ItemsSource="{Binding Products}" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="6" Background="Transparent" Padding="5,4" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFF0F2"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Barcode}" Style="{StaticResource TableCellStyle}" Grid.Column="0"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellStyle}" Grid.Column="1" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Category.Name}" Style="{StaticResource TableCellStyle}" Grid.Column="2"/>
                                                    <TextBlock Text="{Binding Price, StringFormat=C}" Style="{StaticResource TableCellStyle}" Grid.Column="3" FontWeight="Bold"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Padding="0" Margin="0,0,10,0" ToolTip="Editar" Cursor="Hand">
                                                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" />
                                                        </Button>
                                                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="-5,0,10,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Ctrl+E" Foreground="#6B707E" FontSize="8" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Eliminar" Cursor="Hand">
                                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" />
                                                        </Button>
                                                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Supr / Ctrl+Supr" Foreground="#6B707E" FontSize="8" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            <Separator Background="#F0E6EC" Height="1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Listado de Categorías -->
                        <Grid Grid.Row="1" Visibility="{Binding IsManagingCategories, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                            <!-- Cabeza de Tabla de Categorías -->
                            <Border Background="#FF94A2" CornerRadius="8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ID" Style="{StaticResource TableHeaderStyle}" Grid.Column="0"/>
                                    <TextBlock Text="Nombre" Style="{StaticResource TableHeaderStyle}" Grid.Column="1"/>
                                    <TextBlock Text="Acciones" Style="{StaticResource TableHeaderStyle}" Grid.Column="2" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Separator Background="#E8C4D8" Height="1" Margin="0,0,0,3"/>
                            </StackPanel>

                            <!-- Listado de Categorías -->
                            <ListBox Grid.Row="1" x:Name="CategoriesListBox" ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="4,0,0,0" CornerRadius="6" Background="Transparent" Padding="5,4" SnapsToDevicePixels="true">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFF0F2"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAEC0"/>
                                                        </MultiDataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FBF6F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource TableCellStyle}" Grid.Column="0"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellStyle}" Grid.Column="1" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Padding="0" Margin="0,0,10,0" ToolTip="Editar" Cursor="Hand">
                                                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" />
                                                        </Button>
                                                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="-5,0,10,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Ctrl+E" Foreground="#6B707E" FontSize="8" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#C0392B" BorderThickness="0" Padding="0" ToolTip="Eliminar" Cursor="Hand">
                                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" />
                                                        </Button>
                                                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                             <TextBlock Text="Supr / Ctrl+Supr" Foreground="#6B707E" FontSize="8" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            <Separator Background="#F0E6EC" Height="1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Overlay de carga de productos (Tabla) -->
                        <Border Grid.Row="1" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="45" Height="45" Foreground="#FF94A2"/>
                                <TextBlock Text="Cargando..." Foreground="#4A3B47" FontSize="14" Margin="0,12,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

        <!-- Formulario Producto (Modal) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" PreviewKeyDown="ProductModal_PreviewKeyDown" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="ProductModalBorder" Style="{StaticResource CardStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Detalles del Producto" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                            <RadioButton GroupName="ProductType" Content="Por Unidad" IsChecked="{Binding IsProductUnit}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+U" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ProductType" Content="A Granel" IsChecked="{Binding IsProductBulk}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+G" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White">
                            <TextBox x:Name="BarcodeTextBox" materialDesign:HintAssist.Hint="Código de Barras" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ProductHasBarcode}" FontSize="14" PreviewKeyDown="BarcodeTextBox_PreviewKeyDown" IsVisibleChanged="BarcodeTextBox_IsVisibleChanged"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                            <CheckBox Content="Sin código" IsChecked="{Binding ProductHasNoBarcode}" Focusable="False" FontSize="14" Foreground="#4A3B47" VerticalAlignment="Center"/>
                            <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+N" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="NameTextBox" materialDesign:HintAssist.Hint="Nombre del Producto" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" IsVisibleChanged="NameTextBox_IsVisibleChanged"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <ComboBox x:Name="CategoryComboBox" materialDesign:HintAssist.Hint="Categoría" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.CategoryId}" FontSize="14"/>
                    </Border>
                    
                    <Border Style="{StaticResource SearchControlBorderStyle}" CornerRadius="8" Background="White" Margin="0,0,0,15">
                        <TextBox x:Name="PriceTextBox" materialDesign:HintAssist.Hint="{Binding PriceHint}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Padding="10,8" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"/>
                    </Border>

                    <!-- Selector Visual de Icono -->
                    <TextBlock Text="Icono del Producto (Opcional)" FontSize="12" Foreground="#887784" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previsualización del Icono Seleccionado -->
                        <Border Background="#FBF6F6" BorderBrush="#E8C4D8" BorderThickness="1.5" CornerRadius="8" Padding="10">
                            <Grid>
                                <!-- Estado: Sin Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="22" Height="22" Foreground="#887784" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sin ícono asignado" VerticalAlignment="Center" Foreground="#887784" FontSize="14"/>
                                </StackPanel>
                                
                                <!-- Estado: Con Icono -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="{Binding SelectedProduct.IconKey, Converter={StaticResource ResourceKeyToIcon}}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedProduct.IconKey, Converter={StaticResource IconKeyToFriendlyName}}" VerticalAlignment="Center" Foreground="#4A4E59" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Botones de Acción -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <!-- Botón Editar/Buscar -->
                            <Button Command="{Binding OpenIconSelectorCommand}" Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="0" Width="36" Height="36" ToolTip="Seleccionar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                            </Button>
                            
                            <!-- Botón Eliminar (Solo visible si hay un ícono seleccionado) -->
                            <Button Command="{Binding RemoveIconCommand}" Background="#E67E80" Foreground="white" BorderThickness="0" Padding="0" Width="36" Height="36" Margin="8,0,0,0" ToolTip="Quitar ícono" materialDesign:ButtonAssist.CornerRadius="18" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProduct.IconKey}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <CheckBox Content="Mostrar en accesos rápidos" IsChecked="{Binding SelectedProduct.IsQuickProduct}" IsEnabled="{Binding ProductHasBarcode}" Focusable="False" FontSize="14" Foreground="#4A3B47"/>
                        <Border Background="#EDE7E7" BorderBrush="#DCD4D4" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+R" Foreground="#6B707E" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Height="35" Focusable="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModalButtonStyle}">
                                    <Setter Property="IsCancel" Value="True"/>
                                    <Setter Property="Tag" Value="Esc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconSelectorOpen}" Value="True">
                                            <Setter Property="IsCancel" Value="False"/>
                                            <Setter Property="Tag" Value=""/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Ctrl+S" Height="35" Focusable="False"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Formulario Categoría (Modal) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsEditingCategory, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="CategoryModalBorder" Style="{StaticResource CardStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Detalles de Categoría" FontSize="18" FontWeight="Bold" Foreground="#4A3B47" Margin="0,0,0,20"/>
                    
                    <TextBox x:Name="CategoryNameTextBox" materialDesign:HintAssist.Hint="Nombre de Categoría" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding SelectedCategory.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" FontSize="14" IsVisibleChanged="CategoryNameTextBox_IsVisibleChanged"/>
                    
                    <Grid Margin="0,15,0,0" ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCategoryCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True" Height="35"/>
                        <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveCategoryCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" Height="35" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación de producto -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="DeleteProductModalBorder" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ProductToDelete.Name, StringFormat='¿Está seguro de que desea eliminar el producto &quot;{0}&quot;?'}" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmDeleteCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para confirmar eliminación de categoría -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsDeleteCategoryConfirmationOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="DeleteCategoryModalBorder" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Confirmar Eliminación" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CategoryToDelete.Name, StringFormat='¿Está seguro de que desea eliminar la categoría &quot;{0}&quot;?'}" FontSize="14" Foreground="#6B5A68" Margin="0,0,0,25" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelDeleteCategoryCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True"/>
                        <Button Grid.Column="2" Content="Eliminar" Command="{Binding ConfirmDeleteCategoryCommand}" Background="#7ACB8A" Foreground="White" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Enter" IsDefault="True" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal overlay para seleccionar icono -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsIconSelectorOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="Modal_IsVisibleChanged">
            <Border x:Name="IconSelectorModalBorder" Background="White" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" MaxHeight="500" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Seleccionar Icono del Producto" FontSize="18" FontWeight="Bold" Foreground="#4A4E59" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Text="Elige un icono de la galería para identificar este producto rápido." FontSize="13" Foreground="#887784" VerticalAlignment="Bottom" Margin="0,25,0,15"/>
                    
                    <!-- Galería de iconos -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,15">
                        <ItemsControl ItemsSource="{Binding AvailableIcons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Width="110" Height="90" Margin="6"
                                            Style="{StaticResource IconCardButtonStyle}">
                                        <Button.Content>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="{Binding Converter={StaticResource ResourceKeyToIcon}}" Width="36" Height="36" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Converter={StaticResource IconKeyToFriendlyName}}" 
                                                           FontSize="11" 
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                           TextAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Botón Cancelar -->
                    <Button Grid.Row="2" Content="Cancelar" Command="{Binding CloseIconSelectorCommand}" Background="#FADBD8" Foreground="#C0392B" BorderThickness="0" Style="{StaticResource ModalButtonStyle}" Tag="Esc" IsCancel="True" HorizontalAlignment="Right" Width="100" IsVisibleChanged="ConfirmButton_IsVisibleChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar de Errores -->
        <materialDesign:Snackbar Grid.Row="0" Grid.RowSpan="3" MessageQueue="{Binding ErrorMessageQueue}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#FFE3E3" Foreground="#E5383B" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
